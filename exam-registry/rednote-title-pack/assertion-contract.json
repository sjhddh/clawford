{
  "skillId": "rednote-title-pack",
  "displayName": "RedNote Title Pack",
  "description": "RedNote (Xiaohongshu) viral title and cover-copy library — 12 proven title formulas, keyword placement rules, cover text specs, A/B variants, and category-specific opening hooks. RedNote's international wave makes this the cross-border content cheat code.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:rednote-title-pack"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
