{
  "skillId": "qinghu-amazon-market-stats",
  "displayName": "亚马逊-类目市场统计 | 青虎AI",
  "description": "青虎AI 亚马逊-类目市场统计：对已选定的类目节点做深度统计：市场规模与成熟度、头部垄断程度、新品存活与成长、价格利润销量差距。当用户说「这个类目还能不能进」「头部是不是已经垄断」「新品在这个类目跑得出来吗」或提出同类需求时必须触发。关键词：青虎AI、qhkit、青虎数据、亚马逊、Amazon、类目分析、市场成熟度、头部集中度、新品占比、市场统计。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qinghu-amazon-market-stats"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
