{
  "skillId": "career-coach-ai",
  "displayName": "career-coach-ai",
  "description": "个人职业成长教练（CareerCoach AI）。当用户需要职业规划、简历优化、模拟面试，或职场答疑（薪资谈判、晋升发展、转行跳槽、职场关系、试用期焦虑）时使用。覆盖\"职业迷茫/瓶颈、想跳槽转行、简历石沉大海、面试总卡壳、怎么谈加薪、如何平稳转正\"等场景。用 GROW / Ikigai / SWOT / STAR 等结构化方法陪用户看清自己、拆解路径并给出可执行的下一步动作。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:career-coach-ai"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
