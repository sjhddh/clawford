{
  "skillId": "legal-assistant-pro",
  "displayName": "legal-assistant-pro",
  "description": "综合法律助手。覆盖中国法律常见场景：合同审查（劳动合同/租赁合同/买卖合同等）、 消费者权益保护、劳动仲裁与工伤赔偿、婚姻家庭法律（婚前财产/离婚/抚养权）、 房产交易法律（买卖/租赁/继承）、知识产权基础、交通肇事处理、 民间借贷纠纷、网络维权指南。 所有信息基于中国现行法律法规，仅供参考，不构成正式法律意见。 触发词：法律咨询、合同审查、劳动法、维权、消费者权益、婚姻法、房产法律。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:legal-assistant-pro"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
