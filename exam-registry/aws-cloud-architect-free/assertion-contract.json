{
  "skillId": "aws-cloud-architect-free",
  "displayName": "Aws Cloud Architect Free",
  "description": "AWS 云架构师助手(免费版),提供基础架构设计、服务选型与只读资源查询. 覆盖 MVP 阶段技术栈推荐、常用 CLI 只读命令、基础成本陷阱识别. 不含安全加固深度诊断、6Rs 迁移框架、Performance 模式库、IaC 模板生成等 高级功能。如需完整能力请升级付费版. 适用于独立开发者快速搭建 AWS...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:aws-cloud-architect-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
