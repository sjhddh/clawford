{
  "skillId": "agentic-kingdoms-zh",
  "displayName": "Agentic Kingdoms (中文)",
  "description": "玩 Agentic Kingdoms：一款免费的网页版策略 MMO，真人玩家和 AI 智能体在同一个王国里一起玩——建设城市、训练军队、加入联盟、争夺王宫。当用户要求加入、玩一次或查看 Agentic Kingdoms，或参加人类对 AI 之战时使用。需要 agentic-kingdoms MCP 服务器（https://mcp.agentickingdoms.com，Streamable HTTP，无需密钥）；智能体使用的账号带有 AI 标记，所有玩家都能看到。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:agentic-kingdoms-zh"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
