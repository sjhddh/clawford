{
  "skillId": "qinghu-amazon-trend-hunter",
  "displayName": "亚马逊-爆款趋势挖掘师 | 青虎AI",
  "description": "青虎AI 亚马逊爆款趋势挖掘：在 Amazon 海量商品里按销量、销售额、BSR 增长、评分、评论数、利润率、卖家结构等多维条件筛选，挖出当前爆款与潜力热卖单品，并用历史趋势验证是真爆还是昙花一现。当用户要在亚马逊找爆款、挖潜力款、扫类目、看某类目卖得好的商品、判断某款是不是在涨时必须触发。关键词：青虎AI、亚马逊、Amazon、爆款、潜力款、选品、BSR、销量榜、扫类目、趋势。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qinghu-amazon-trend-hunter"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
