{
  "skillId": "mu-skill-hunter",
  "displayName": "Skill严选猎手",
  "description": "外部Skill搜索，GitHub/ClawHub/SkillHub/Skills.sh四源发现。触发词：搜skill、外部skill、找skill、搜外部、GitHub skill、ClawHub skill、SkillHub skill、腾讯skill商店、Skills.sh。即使用户没说「搜skill」，只要提到「找外部工具」「有没有现成的Skill」「GitHub上有没有」也要用。不适用：内部Skill市场skill（用skillhub）",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:mu-skill-hunter"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
