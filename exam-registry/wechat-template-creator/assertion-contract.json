{
  "skillId": "wechat-template-creator",
  "displayName": "wechat-template-creator",
  "description": "微信公众号文章排版模板创作工具。采用向导式交互，提供「行业模板模式」和「完全自定义模式」两种创作路径。行业模板模式包含科技互联网、教育培训、金融理财、健康医疗、美食生活、文艺情感、商业咨询 7 个预设行业模板；完全自定义模式支持逐项配置正文、标题、段落间距、头部、底部、划重点、引用块、代码块、表格、列表等 10 大类排版要素。触发场景：创建公众号文章模板、设计微信排版样式、制作公众号排版方案、微信文章美化。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:wechat-template-creator"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
