{
  "skillId": "linkpix-scene-image",
  "displayName": "电商商品场景图生成器 | LinkPix",
  "description": "根据商品自动生成真实、高质感的商品场景图，适用于家居、美妆、服饰、数码等行业。当用户要求生成商品场景图、使用场景展示图、氛围图、生活方式图（lifestyle）时必须触发。关键词：LinkPix、qhkit、场景图、商品场景、使用场景、氛围图、lifestyle、生活方式图、实景图、家居场景、美妆场景、点击率、转化率。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:linkpix-scene-image"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
