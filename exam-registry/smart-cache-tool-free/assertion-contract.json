{
  "skillId": "smart-cache-tool-free",
  "displayName": "智能缓存工具-免费版",
  "description": "智能缓存管理工具免费版,面向个人开发者与小型项目. 核心能力: - LRU/LFU 缓存策略 - TTL 自动过期失效 - 内存缓存管理 - 缓存命中率统计 - 手动缓存清理 - 简单持久化支持 适用场景: - API 响应缓存 - 计算结果缓存 - 文件内容缓存 - 个人项目性能优化 差异化:免费版提供基础缓存能力。PRO版扩展分布式缓存、多级缓存与智能预热. 适用关键词: cache, lru, lfu, ttl, 缓存, 缓存策略, 命中率, 缓存失效",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:smart-cache-tool-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
