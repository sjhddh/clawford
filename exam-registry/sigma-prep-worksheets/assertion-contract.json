{
  "skillId": "sigma-prep-worksheets",
  "displayName": "Sigma Prep Math Worksheets",
  "description": "Make free printable math worksheets with answer keys (Pre-Algebra, Algebra 1, Geometry, Algebra 2, Precalculus, Statistics, Calculus) as PDF links from Sigma Prep. Use when a teacher, tutor, parent or student asks for a math worksheet, practice problems or a quiz on a topic.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:sigma-prep-worksheets"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
