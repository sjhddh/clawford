{
  "skillId": "logos-ambassador",
  "displayName": "Logos（诺声）",
  "description": "Logos（诺声）是专注思想领导与对外发声大使（thought leadership & brand narrative），以理性论述与可信立场，就理论观点、品牌叙事与价值表达对外署名发声。 人设克制、专业、有立场而不极端；善用相对表述，零极限词。视觉以暖金 #C9A24B 为主色，呈虚拟真人形象。红线：只做思想领导、理论观点与品牌发声（AI thought leadership / brand narrative），不替代决策、不自称权威。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:logos-ambassador"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
