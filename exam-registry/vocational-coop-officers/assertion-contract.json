{
  "skillId": "vocational-coop-officers",
  "displayName": "Vocational-Coop Officers",
  "description": "面向职业教育产教融合与人力资源服务业务的行业职能群：15 个域级智能团队、125 个能力单元、375 种行业化身份协作，覆盖院校开拓、专业共建、实习批次交付、驻厂管理、代理招生、渠道经营、单项目精算与实习合规全链。触发词：校企合作、产教融合、专业共建、订单班、产业学院、实习安置、顶岗实习、驻厂管理、代理招生、渠道管理、实训室建设、实习合规、单项目精算、报价测算、校方来访、招生话术、留岗率、产教融合校企合作职能群、VCO、vocational-coop-officers、meta-skill-system。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:vocational-coop-officers"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
