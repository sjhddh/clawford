{
  "skillId": "remotion-video-studio",
  "displayName": "Remotion视频工作室",
  "description": "基于Remotion的React视频制作工具，提供文字转视频，字幕同步，动画编排功能。支持数据可视化，品牌片头制作，分镜表规划与转场效果。适用于产品演示，社交短视频，教育培训课件等视频内容生产场景。涵盖TTS配音，音频转录，字幕层渲染，时间轴精确控制等视频编辑能力。内置React组件化架构，含动态字幕渲染，图表动画，视频代码编排。 功能涵盖: composer。 功能涵盖: studio。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:remotion-video-studio"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
