{
  "skillId": "finance-news-aggregator",
  "displayName": "AI News Aggregator",
  "description": "AI/技术新闻 + 财经资讯聚合引擎（Scope: AI/tech RSS feeds and public financial-news aggregation）。100+ RSS 源并发抓取、兴趣评分、跨天去重、统一预取；含源可信度分级、交叉验证规则、时效分级、日报/周报/专题输出模板。Advisory-only, no execution, no persistence, no financial advice.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:finance-news-aggregator"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
