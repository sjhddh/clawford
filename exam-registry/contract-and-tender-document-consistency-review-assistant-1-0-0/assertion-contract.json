{
  "skillId": "contract-and-tender-document-consistency-review-assistant-1-0-0",
  "displayName": "Contract And Tender Document Consistency Review Assistant 1.0.0",
  "description": "对照招标文件与投标文件（含中标通知书），逐条审查拟签/已签合同是否背离招投标实质性内容（标的、价款、质量、履行期限、违约责任），识别文字游戏与隐蔽让利，输出可审计的合规审查报告。触发词：合同与招标文件不一致、签约前核对、阴阳合同、黑白合同、合同背离投标、审查合同偏离、合同一致性审查、标后合同核对。当用户需要把合同和招/投标文件做一致性比对，或怀疑签约阶段存在变相让利、付款节点变更、违约金调低等情形时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:contract-and-tender-document-consistency-review-assistant-1-0-0"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
