{
  "skillId": "webto-ai-ecosystem",
  "displayName": "HTML一键托管",
  "description": "WebToWork（webto.work）平台 AI 生态能力参考技能包。当用户要使用或咨询该平台的 AI 助手挂载、知识库检索增强、模板市场与 AI 草稿、分享页 PWA 化、APK 在线打包、网址一键克隆、AI SEO 与多语言出海、做同款定价、流量与线索复盘、事件 Webhook、会员专区、微信小程序 AI 等能力时使用。覆盖 40 个 MCP 工具与开放 REST API 的接入方式、鉴权、限流与能力边界。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:webto-ai-ecosystem"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent execute the browser workflow deterministically with explicit checkpoints?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final browser state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "browserWorkflow_run_{{rand}}"
      ]
    }
  }
}
