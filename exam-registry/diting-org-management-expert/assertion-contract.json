{
  "skillId": "diting-org-management-expert",
  "displayName": "Diting Org Management Expert",
  "description": "谛听组织管理专家。组织架构设计、团队管理、沟通协作、领导力发展、组织变革管理。Use when 组织架构设计、团队管理、沟通协作、领导力发展、组织变革管理、跨部门协作、管理幅度优化、组织效能提升、组织诊断、管理梯队建设、组织变革规划。不适用于薪酬结构、劳动法合规、培训方案设计、绩效指标设计等非组织管理类问题。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:diting-org-management-expert"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
