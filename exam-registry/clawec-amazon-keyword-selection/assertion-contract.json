{
  "skillId": "clawec-amazon-keyword-selection",
  "displayName": "clawec-amazon-keyword-selection",
  "description": "通过 ClawEC API 进行亚马逊关键词选品（通过关键词月搜索量、购买率、供需比与蓝海指数，找出细分市场中蕴藏的商机），可选 AI 解读。在用户需要关键词选品、亚马逊关键词选品、keyword research、/tool/keyword-research 时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:clawec-amazon-keyword-selection"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
