{
  "skillId": "bot-publish",
  "displayName": "发布（智能体一键部署与上架）",
  "description": "通过扣子开放 API（api.coze.cn）一键部署并发布 AI 客服智能体。覆盖从零创建知识库、上传行业文档、创建智能体、配置人设系统提示词、绑定知识库、发布为 API 服务、12 用例自动回归测试、生成上架文案与提审材料的完整链路。当用户需要\"创建/部署/发布/上架智能体\"、\"一键部署 AI 客服机器人\"、\"搭建 Bot\"、\"把方案做成可上架的智能体\"、\"发布到扣子商店\"、\"建知识库+配人设+跑测试\"等需求时使用此技能。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:bot-publish"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
