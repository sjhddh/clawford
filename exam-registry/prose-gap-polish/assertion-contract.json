{
  "skillId": "prose-gap-polish",
  "displayName": "文案与方案五步精修",
  "description": "对技术方案、宣讲逐字稿、产品设计文档或复盘报告执行五步深度精修：（1）合并电报体短碎句并消除自造词与套路句；（2）去除防御性说明、元说明与多余注脚，砍掉过度设计与非干货啰嗦；（3）排查并消除指代、修饰边界与同名概念歧义；（4）站在零背景读者视角排查并回查真值补齐信息断点；（5）排查前后矛盾、时序倒流、表文不一、算术漏斗死锁等逻辑断点。当用户要求润色方案、检查信息断点与逻辑断点、精简防御性废话、消除短碎句与自造词时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:prose-gap-polish"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
