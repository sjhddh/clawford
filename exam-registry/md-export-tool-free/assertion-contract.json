{
  "skillId": "md-export-tool-free",
  "displayName": "文档导出工具免费版",
  "description": "面向内容创作者与开发者的Markdown多格式导出工具。通过命令行将Markdown文本快速变换为DOCX、PDF、HTML、XLSX、CSV、JSON、XML等主流格式，免去手动排版与格式调整的繁琐工作，特别适合技术文档、报告、数据表导出场景。Use. 适用于需要md export tool相关能力的开发场景,提供结构化的工作流程和配置指引.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:md-export-tool-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
