{
  "skillId": "mu-q12-survey",
  "displayName": "Q12敬业度调研助手",
  "description": "基于盖洛普Q12敬业度调研工具，帮助团队经理、HRBP、组织发展专员设计员工敬业度调研问卷、解读调研结果、制定90天改进计划。触发词：敬业度问卷、Q12调研、员工满意度调查、团队氛围调研、敬业度评分、留人问题、团队状态诊断、怎么提升团队敬业度、eNPS、盖洛普、员工离职。适用角色：团队经理、HR BP、组织发展专员。不适用：普通员工（非管理者）使用、大规模统计建模、已有专业调研系统的场景。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:mu-q12-survey"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
