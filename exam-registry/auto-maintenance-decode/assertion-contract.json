{
  "skillId": "auto-maintenance-decode",
  "displayName": "保养项目解读台",
  "description": "保养单上项目一堆，车主分不清哪些是厂商要求、哪些是门店推荐，容易多花冤枉钱，也可能漏掉真该做的。 输入：车型与年款、行驶里程、用车环境（城市拥堵/高速/多尘）、本次推荐项目清单、以往保养记录。输出：①项目分级（必做/建议做/可延后/无必要，各自理由）②更换周期判断依据（里程 or 时间 or 用车环境）③可自行检查的项（怎么看机油/刹车片/轮胎）④常见过度推荐话术与应对 ⑤到店沟通清单（要问哪些、要不要看旧件）⑥费用区间参考思路。永久免费，无需付费、无需授权（MIT-0）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:auto-maintenance-decode"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
