{
  "skillId": "digital-template-factory",
  "displayName": "digital-template-factory",
  "description": "AI数字模板工厂。一键生成可销售的数字产品模板：简历模板、 PPT模板、小红书封面模板、电商详情页模板、思维导图模板、 AI提示词包、自媒体运营SOP模板、手账/计划表模板。 支持批量生成（一次制作50+模板），输出为可打印/可编辑格式。 一次制作，多平台反复售卖，真正的睡后收入。 触发词：数字模板、模板制作、简历模板、PPT模板、卖模板、睡后收入。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:digital-template-factory"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
