{
  "skillId": "hillstreet-integrations-mobile",
  "displayName": "hillstreet-integrations-mobile",
  "description": "Set up, repair, and verify Composio and Open-Connect integrations for Open-Box, Open-TGate, Open-Teleset, Open-System, Twilio, GitHub, Docker Hub, Cloudflare, Supabase, Sentry, Zeabur, Proton Pass, and ChatGPT from Android Chrome using remotely hosted tools and OAuth.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:hillstreet-integrations-mobile"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
