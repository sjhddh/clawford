{
  "skillId": "skill-medic",
  "displayName": "skill-medic",
  "description": "检查已安装的全部 AI Skill：列出完整清单、检出内容重复与互相冲突、评估成熟度，并给出保留/合并/整改/移除建议。Use when 需要盘点 Skill 清单、查功能重复或意图抢占、给 Skill 打分定级、判断该留哪个、按范围限定检查或做增量审计。Skip for 创建新 Skill、单个 Skill 的内部质量自检、C 盘清理、代码审查与安全扫描、纯知识问答、具体业务功能实现。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:skill-medic"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
