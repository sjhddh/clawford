{
  "skillId": "patent-data-quality",
  "displayName": "专利数据质检",
  "description": "专利数据质检、专利表格检查、专利数据缺失检查。当用户准备导入或交付专利数据，需要查缺列、空值、日期和重复号码时使用；不把表格检查说成数据库真实性核验。 Inspect supplied patent CSV data for missing fields, publication-number format issues, date precision, chronological review points and duplicate identifiers without changing the source records.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:patent-data-quality"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
