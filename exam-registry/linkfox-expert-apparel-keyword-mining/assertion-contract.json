{
  "skillId": "linkfox-expert-apparel-keyword-mining",
  "displayName": "服装品类关键词挖掘专家",
  "description": "专为服装类目设计的关键词挖掘与语义打标一体化工具。从商品图提炼真实属性写出精准 product_context，用 Amazon Suggestions 挖出长尾词，通过 LLM 语义打标识别完整属性短语，自动完成肯定/否定词库分流，产出可用于 Listing 和 PPC 的结构化词库。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:linkfox-expert-apparel-keyword-mining"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
