{
  "skillId": "psychology-paper-reviewer",
  "displayName": "psychology-paper-reviewer",
  "description": "以心理学学术期刊审稿人的标准，对心理学论文、研究计划、开题报告或论文片段进行结构化评审。当用户说“审稿”“帮我评审这篇论文”“检查研究设计”“评价方法部分”“review this psychology paper”“peer review”或要求从学术审稿角度指出问题时使用。适用于实证研究、问卷研究、实验研究、纵向研究及常见心理学定量研究。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:psychology-paper-reviewer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
