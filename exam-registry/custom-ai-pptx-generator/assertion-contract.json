{
  "skillId": "custom-ai-pptx-generator",
  "displayName": "Custom-AI-PPTX-Generator",
  "description": "Custom AI PPTX Generator — Design-driven, editable PowerPoint creation from your content. 可定制化AI 演示文稿（PPT）生成器AI-PPT workflow. This skill should be used when the user asks to create a PPT / presentation / training deck / project briefing / policy explainer from requirement n",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:custom-ai-pptx-generator"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the generated content align with the requested scope and structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate output quality against explicit criteria?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "contentGenerator_run_{{rand}}"
      ]
    }
  }
}
