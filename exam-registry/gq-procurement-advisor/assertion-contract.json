{
  "skillId": "gq-procurement-advisor",
  "displayName": "gq-procurement-advisor",
  "description": "国企采购合规实务助手。当用户咨询国企采购合规、国有资金采购方式选择、53号文适用场景、招标文件审查、国企采购风险评估、非招标采购方式论证、采购需求编制时触发。典型触发语：国企采购、53号文、非招标采购、国有企业采购管理、询比采购、竞价采购、直接采购、国资委采购规定。不适用于政府采购（那是政府采购合规顾问的工作），不适用于纯工程建设项目招标的招投标法合规问题（那是投标合规顾问的工作）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:gq-procurement-advisor"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
