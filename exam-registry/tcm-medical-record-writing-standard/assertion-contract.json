{
  "skillId": "tcm-medical-record-writing-standard",
  "displayName": "tcm-medical-record-writing-standard",
  "description": "中医、中西医结合病历书写基本规范（试行）全文检索（国中医药发〔2002〕36号，2002-09-01 施行）。 覆盖门急诊病历、住院志、病程记录、手术麻醉记录、医嘱、护理记录、出院/死亡记录等全部文书的书写要求、 内容清单与完成时限。当用户问\"入院记录几小时内完成\"\"首次病程记录时限\"\"主治查房记录\"\"抢救记录怎么补记\" \"手术记录谁写\"\"医嘱单分几种\"\"出院记录内容\"\"中医四诊怎么记入体格检查\"等病历书写与病案管理问题时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:tcm-medical-record-writing-standard"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
