{
  "skillId": "aws-agentcore-langgraph-free",
  "displayName": "Aws Agentcore Langgr",
  "description": "AWS AgentCore与LangGraph部署助手(云写操作需谨慎)。Multi-agent systems on AWS Bedrock AgentCore with LangGraph orchestration. Source: <。适用于多种工作场景,提供专业的能力支持。轻量级设计,低资源占用,适配云端与本地部署。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:aws-agentcore-langgraph-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
