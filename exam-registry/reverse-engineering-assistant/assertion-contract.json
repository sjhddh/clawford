{
  "skillId": "reverse-engineering-assistant",
  "displayName": "Reverse-Engineering Assistant",
  "description": "在授权范围内对已发布软件做逆向分析：追踪功能实现、还原算法与数据格式、对比版本差异、复现功能。支持安装包、二进制、Electron/JS 应用、.NET 程序集、安卓 APK、网站、固件等目标。触发词：逆向、逆向分析、反编译、拆包分析、复现功能、还原算法、分析安装包、版本差异、reverse engineering、reverse-engineering-assistant、meta-skill-system",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:reverse-engineering-assistant"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
