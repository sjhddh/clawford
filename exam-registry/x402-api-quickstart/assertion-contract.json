{
  "skillId": "x402-api-quickstart",
  "displayName": "x402-api-quickstart",
  "description": "Teaches AI agents how to call ANY x402 pay-per-call HTTP API: the HTTP 402 flow, X-PAYMENT-REQUIREMENTS, EIP-3009 exact-scheme USDC payment on Base, and retry with X-PAYMENT header. Includes 6 live example endpoints ($0.0002-$0.01/call) to test against. No signup.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:x402-api-quickstart"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
