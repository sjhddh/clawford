{
  "skillId": "smart-procurement-expert",
  "displayName": "智慧招采专家Smart Procurement Expert",
  "description": "投标人侧招投标与政府采购全周期合规导航助手。覆盖商机甄别、投标决策、任务分解、招标解析、章节初稿生成、文稿润色、图表占位、呈交终审、一致性审查、评标应对、质疑投诉救济与经验沉淀；内置两法分轨判定（招投标法 / 政府采购法）、三档安全护栏、前沿适配（电子招投标 / 中小企业 / 双信封 / ESG / 围串标）与 IMA 知识库联动，并集成已验证的深度能力（一致性严格审查、真实 docx 章节初稿生成 + 内容自动填充、价格分自动算分引擎）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:smart-procurement-expert"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
