{
  "skillId": "ima-mcp-cos-upload",
  "displayName": "ima-mcp-cos-upload",
  "description": "把本地文件（md/pdf/pptx/docx/图片等）上传导入 ima 知识库：走通 create_media → COS 签名直传 → add_knowledge 全流程，自带 403 报错自修复；md 卡片上传前可按规范自动打标（原料层三段式/资产层五维）。触发：上传文件到 ima 知识库、ima 导入文档、ima 推库/入库、上传报 COS 403 或 SignatureDoesNotMatch、ima 打标。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ima-mcp-cos-upload"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
