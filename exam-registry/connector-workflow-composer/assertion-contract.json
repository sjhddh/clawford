{
  "skillId": "connector-workflow-composer",
  "displayName": "Connector Workflow-Composer",
  "description": "连接器工作流编排：首次使用即扫描 WorkBuddy 连接器市场全部连接器并按逻辑分类排序展示，按用户需求组合连接器为工作流（对话内编排/定时自动化/固化复用三层次），并主动生成跨连接器灵感组合建议。触发词：连接器、工作流、连接器组合、自动化流程、灵感组合、connector-composer、meta-skill-system。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:connector-workflow-composer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
