{
  "skillId": "medical-device-samd",
  "displayName": "SaMD软件医疗器械专家",
  "description": "SaMD（Software as a Medical Device）软件即医疗器械专题技能——SaMD 判定与 IMDRF N12 风险分类（I-IV 类）+ IEC 62304 软件生命周期（A/B/C 级）+ FDA 软件三级关注（Major/Moderate/Minor）+ MDR 软件分类规则 11 + 网络安全（MDCG 2019-16、FDA 网络安全指南、SBOM）评估清单。独立软件/含软件器械注册申报的软件文档怎么搭、分类怎么定、网络安全怎么做，一站理清，附官方入口直达。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:medical-device-samd"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
