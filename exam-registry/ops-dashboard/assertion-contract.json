{
  "skillId": "ops-dashboard",
  "displayName": "运维看板(专业版)",
  "description": "全功能实时运维监控看板，支持成本分析、变更操作、告警通知与审计日志。运维看板专业版是面向团队和企业的完整运维监控方案，在免费版基础上解锁成本分析与用量统计、变更操作与备份管理、告警通知与自动。支持自动化配置和灵活的参数设置，适覆盖多种使用场景，优化工作流程和效率。运维看板专业版是面向团队和企业的完整运维监控方案，在免费版基础上解锁成本分析与用量统计、变更操作与备份管理、告警通知与自动 功能涵盖: ops, dashboard。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ops-dashboard"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
