{
  "skillId": "customer-acquisition-engine",
  "displayName": "客户获取引擎",
  "description": "当用户的请求涉及以下任一关键词或意图时使用此技能：获客、找客户、销售线索、潜在客户、竞品截流、评论区挖掘、意向筛选、私域引流、抖音搜索、短视频营销、热点借势、对标账号分析、爆款监控。支持关键词多维搜索、创作者作品获取、评论数据提取、实时热榜四项能力，即使用户表述模糊如\"帮我看看这个视频评论里有没有潜在客户\"也应触发。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:customer-acquisition-engine"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
