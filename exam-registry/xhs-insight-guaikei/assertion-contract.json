{
  "skillId": "xhs-insight-guaikei",
  "displayName": "guaikei·小红书洞察",
  "description": "搜索/查看/抓取小红书公开笔记、评论与博主作品，返回结构化数据。当用户提到小红书、红笔记、xhs、rednote，或给出 xiaohongshu.com/xhslink.com 链接，且想了解内容、找爆款、分析竞品、筛 KOL、看评论、追趋势、做选题、准备报告时使用本技能；即使用户没明确说\"小红书\"或\"数据\"，只要语境是社媒内容调研也适用。不用于登录、发布或其他平台。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:xhs-insight-guaikei"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
