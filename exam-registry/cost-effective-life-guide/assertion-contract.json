  "description": "高性价比人生指南（GitHub 开源 HowToLiveBetter）：544 条按性价比排序的生活决策建议，证据分级（A 级 358 条 RCT/荟萃分析级）。当用户问健康防病、急救处理、省钱理财、防骗、法律红线、租房买房、婚恋成本、育儿、工伤离职、看病就医、留学出路等生活决策问题时使用。覆盖十大领域 32 节，条目含成本/收益/证据硬度三要素。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:cost-effective-life-guide"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
