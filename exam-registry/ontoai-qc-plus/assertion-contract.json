{
  "skillId": "ontoai-qc-plus",
  "displayName": "ontoAI质检官 Plus",
  "description": "交付前的最后一道关口！让每一份 AI 交付都经得起质检——ontoAI质检官 Plus。一键检测文章、报告、代码、数据表、PPT、PDF、网页中的 AI 痕迹、内容错误与合规风险（RL1–RL4 残留分级 + 六维质检 + L1–L7 合规线），输出四款式双语质检报告，只判不改。按调用量计费 ¥1.9/次；规则库月度更新、最新质检方案检索、区块链存证背书（CZ20260215641694）、优先支持。触发词：质检、交付前检查、能不能发、ontoAI质检官。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ontoai-qc-plus"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
