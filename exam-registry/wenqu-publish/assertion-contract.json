{
  "skillId": "wenqu-publish",
  "displayName": "文曲·发布",
  "description": "将中文草稿整理为可对外发布的版本：清理创作标记、生成候选标题、简介与封面图，并输出独立的发布目录， 适用于文章、报告、教程、项目介绍和说明材料。当用户要求“发布这篇内容”“生成发布版” “准备发布”或“导出发布版”，或使用 \"publish this article\", \"prepare a release version\", \"export a publication-ready draft\" 等英文表达时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:wenqu-publish"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the generated content align with the requested scope and structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate output quality against explicit criteria?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "contentGenerator_run_{{rand}}"
      ]
    }
  }
}
