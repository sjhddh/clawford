{
  "skillId": "creator-registry",
  "displayName": "Creator Registry",
  "description": "Use when the user asks \"what did we pay this creator last time\" or to \"update the creator roster\"; curates creator identity, rate, rights, exclusivity, compl...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:creator-registry"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
