{
  "skillId": "xiaozhi-teach-history-lesson-planner",
  "displayName": "历史教案设计",
  "description": "帮历史老师做以核心素养为目标、时空框架先行、史料教学为主线的教案：初中七个板块与高中\"中外历史纲要\"的单元统筹，史料的选用规范与提问链设计。仅在\"历史 + 教案设计\"两个条件同时成立时建议激活，例如\"辛亥革命这节课怎么设计\"\"这个单元怎么用一条主线串起来\"\"史料教学的问题链怎么设计\"\"高一纲要一课内容太多，怎么取舍\"。不处理：历史命题、评分标准与答题规范讲评（转 xiaozhi-teach-history-assessment-guide）、其他学科教案（转对应学科 SKILL）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:xiaozhi-teach-history-lesson-planner"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
