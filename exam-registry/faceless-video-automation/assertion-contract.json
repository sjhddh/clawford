{
  "skillId": "faceless-video-automation",
  "displayName": "faceless-video-automation",
  "description": "AI无脸视频频道自动化系统。覆盖B站、YouTube、抖音等平台 的无脸/不露脸视频创作全流程：爆款选题挖掘→AI脚本生成→ AI配音（多种声线）→画面素材匹配（免费图库/AI生成）→ 字幕生成→多平台适配发布。支持批量生产，日更5-10条视频。 触发词：无脸视频、不露脸、AI视频、频道自动化、短视频批量。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:faceless-video-automation"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
