{
  "skillId": "alipay-aipay",
  "displayName": "支付宝 AI 付接入",
  "description": "支付宝 AI 付接入 Skill。当用户选择完成 AI 按量付费、AI 网页应用收款、AI 移动应用收款三类支付宝收单产品的代码开发、产品开通或全流程同时完成两者时，使用此 Skill。 触发关键词：\"AI支付\"、\"接支付宝\"、\"一站式接支付宝\"、\"接个支付\"、\"开发支付\"、\"402收款\"、\"AI按量付费\"、\"AI网页应用收款\"、\"AI移动应用收款\"、\"按量付费\"、\"快捷收款\"、\"快捷收单\"、\"网站支付\"、\"APP 支付\"、\"产品开通\"、\"商家开通\"、\"签约入驻\"等。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:alipay-aipay"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
