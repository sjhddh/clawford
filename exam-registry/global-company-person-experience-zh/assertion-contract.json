{
  "skillId": "global-company-person-experience-zh",
  "displayName": "支持海外公司人员教育背景查询，按人员 ID 从全球公司数据库获取含院校、学位、专业与绩点的教育经历。帮助招聘人员、HR团队与用人经理核验学历背景、评估候选人资质、做出明智招聘决策——适合候选人筛选、背景核验与人才评估。",
  "description": "调取全球企业人员数据库获取目标人员的任职履历和完整工作时间线，充实 B2B 销售线索画像，梳理联系人过往任职经历，研判对方职业发展轨迹。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:global-company-person-experience-zh"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
