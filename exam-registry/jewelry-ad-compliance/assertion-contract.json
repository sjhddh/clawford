{
  "skillId": "jewelry-ad-compliance",
  "displayName": "营销文案合规审查",
  "description": "珠宝行业营销文案合规审查。当用户需要审核珠宝或饰品类的宣传文案、商品详情页、直播话术、朋友圈或短视频文案、活动海报文案等是否违反广告法及行业监管规定时使用。自动加载红橙黄三级词库，扫描高危词（如国家级、第一）、中危词（如极致、完美）及珠宝专属风险点（纯度、功效、产地、促销话术等），结合上下文判定是否违规，并输出带三色标注的合规审查报告。触发词包括合规审查、广告法风险、审一下这段文案、珠宝文案合规。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:jewelry-ad-compliance"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
