{
  "skillId": "jellyfin-control-tool-free",
  "displayName": "媒体服务器控制",
  "description": "轻量级 Jellyfin 媒体服务器控制工具，支持内容搜索、播放控制与设备管理，适合个人家庭影音娱乐使用。核心能力: - 一键播放：搜索内容并自动开始播放 - 智能续播：自动定位上次观看位置 - 设备发现：自动检测可控设备 - 播放控制：暂停、继续、下一集、音量控制 适用场景: - 个人家庭影音播放控制 - 电视剧追剧续播 - 电影快速搜索播放 差异化: - 免费版聚焦单设备控制，操作简单 - 一键播放，无需手动操作电视 - 智能续播...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:jellyfin-control-tool-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
