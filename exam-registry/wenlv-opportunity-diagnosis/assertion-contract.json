{
  "skillId": "wenlv-opportunity-diagnosis",
  "displayName": "wenlv-opportunity-diagnosis",
  "description": "文旅项目机会诊断能力包，是一款投资前置判断工具，将15年文旅操盘经验提炼为「五维决策门+政策红线」的漏斗框架，对文旅项目做 go/no-go 前置判断。在你做设计、签合同、打款、动工之前，回答一个核心问题：这个项目，值不值得进？\n当用户提到文旅项目研判、地块/资源值不值得做、项目机会诊断、投资前可行性初判、文旅选址评估、项目问题诊断、项目能不能做、文旅项目体检、项目 go/no-go 判断时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:wenlv-opportunity-diagnosis"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
