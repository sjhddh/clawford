{
  "skillId": "patent-bibliography",
  "displayName": "专利参考文献",
  "description": "专利参考文献、专利引用格式、专利文献目录。当用户已有专利清单，需要整理可追溯的引用条目或按给定模板输出参考文献时使用；不是专利引证网络分析。 Prepare numbered patent bibliography entries from supplied bibliographic records, preserving publication identifiers, dates, responsible-party roles, source fields and missing-data notes.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:patent-bibliography"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
