{
  "skillId": "ima-plus-skill",
  "displayName": "ima.plus-skill-v1.0.12",
  "description": "优化了上传视频转换成HTML的功能，有任何skill的问题或建议，请到QQ频道：pd86156007，IMA 知识库与笔记操作技能（版本 v1.0.12）：用 `--path` 自然语言定位知识库/文件夹/笔记本，支持文件上传、知识库/目录导出 zip、文件夹与条目管理、标签权限、网页入库、笔记增改与插图，以及把本地视频封装成单文件 HTML（页面内置「导出视频」，导出为 .bin 后缀、改名 .mp4 即播放）入库（需环境变量 IMA_OPENAPI_CLIENTID / IMA_OPENAPI_APIKEY）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ima-plus-skill"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
