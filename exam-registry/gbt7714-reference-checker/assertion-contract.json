{
  "skillId": "gbt7714-reference-checker",
  "displayName": "GB/T 7714—2025 参考文献著录检查",
  "description": "参考文献著录合规检查，依据《信息与文献 参考文献著录规则》（GB/T 7714—2025）新国标逐条核验参考文献的著录格式。当用户提到检查/核验参考文献、参考文献格式是否正确、是否符合GB/T 7714、新国标著录规则、引文格式检查，或提交参考文献列表、含参考文献的论文/文档希望审查格式时触发。不适用于：查找/收集/导出参考文献（题录检索）、引文样式转换（如APA转GB/T 7714）、参考文献内容真实性核验。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:gbt7714-reference-checker"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
