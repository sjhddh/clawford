{
  "skillId": "juhe-enterprise-restriction",
  "displayName": "企业限制高消费信息查询 - 聚合数据",
  "description": "企业限制高消费信息查询。根据企业名称、统一社会信用代码、工商注册号或申请人查询限制消费令，返回案号、执行法院、立案时间、案件状态、关联人、申请人及限令正文。使用场景：用户说\"限高\"、\"限制高消费\"、\"限制消费令\"、\"这家公司被限高了吗\"、\"不能坐飞机高铁\"、\"查一下限高记录\"等。通过聚合数据（juhe.cn）API 实时查询。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:juhe-enterprise-restriction"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
