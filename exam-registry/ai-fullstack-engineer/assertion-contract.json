{
  "skillId": "ai-fullstack-engineer",
  "displayName": "ai-fullstack-engineer",
  "description": "AI 全栈应用工程师技能库：覆盖从 API 设计、数据库、后端架构、FastAPI 开发，到前端组件、CSS 布局、Web 性能、浏览器调试的全链路能力，并内置 AI-native 全栈工作流（契约优先、前后端并行、类型安全、AI 辅助调试与一键脚手架）。触发词：\"全栈\"、\"搭一个应用\"、\"前后端一起\"、\"设计 API\"、\"数据库 Schema\"、\"FastAPI\"、\"React/Vue 组件\"、\"CSS 布局\"、\"性能优化\"、\"Lighthouse\"、\"浏览器调试\"、\"脚手架\"、\"Next.js\"、\"App Router\"、\"Tailwind 审计\"。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ai-fullstack-engineer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent execute the browser workflow deterministically with explicit checkpoints?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final browser state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "browserWorkflow_run_{{rand}}"
      ]
    }
  }
}
