{
  "skillId": "law-ip-selfcheck",
  "displayName": "知识产权自检台",
  "description": "字体、图片、音乐、商标、软件授权——很多侵权不是故意，而是不知道就用了；自己被抄了也不知道怎么留证据。 输入：使用场景（公众号/短视频/电商详情页/软件产品/课程）、素材来源、是否商用、自己的原创成果类型。输出：①风险点清单（按素材类型：字体/图片/音乐/商标/开源许可）②替代方案（可商用的替代做法）③留痕清单（创作过程、时间戳、发布记录）④维权准备（发现被侵权先做什么）。永久免费，无需付费、无需授权（MIT-0）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:law-ip-selfcheck"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
