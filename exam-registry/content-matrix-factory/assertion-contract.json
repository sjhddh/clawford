{
  "skillId": "content-matrix-factory",
  "displayName": "content-matrix-factory",
  "description": "AI自媒体矩阵内容工厂。覆盖小红书种草笔记、抖音带货脚本、 公众号长文、微博/知乎短内容的多平台矩阵运营。 核心能力：多账号内容批量生成、图文带货文案自动撰写、 各平台风格自适应改写、内容排期管理、热点追踪+借势创作。 支持矩阵化运营（3-20个账号同时管理）。 触发词：自媒体矩阵、内容工厂、小红书种草、图文带货、多平台运营。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:content-matrix-factory"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the generated content align with the requested scope and structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate output quality against explicit criteria?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "contentGenerator_run_{{rand}}"
      ]
    }
  }
}
