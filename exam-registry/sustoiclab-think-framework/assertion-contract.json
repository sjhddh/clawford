{
  "skillId": "sustoiclab-think-framework",
  "displayName": "Sustoiclab Think Framework思考框架工具箱 · Su's StoicLab",
  "description": "思考框架工具箱 · Su's StoicLab。当用户需要分析问题原因、做战略评估、对比选项做决策、多角度全面思考或优化精力分配时使用。覆盖根因分析(5W2H+鱼骨图)、战略评估(SWOT+波特五力)、决策支持(决策矩阵+成本效益)、多维思考(六顶思考帽)、效率聚焦(80/20法则+逆向思维)等场景。原创作品 by 苏庶 @ 钝感实验室。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:sustoiclab-think-framework"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
