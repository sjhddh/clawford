{
  "skillId": "auto-complaint-handler",
  "displayName": "汽车经销商客诉话术生成器",
  "description": "汽车经销商客诉话术生成器。当用户描述一个汽车客诉场景（如漏水、异响、保养纠纷、交付延期、新媒体投诉、12315介入等），生成专业的应对话术、处理流程和升级建议。适用于4S店售后经理、CRM经理、客户权益官(CAEM)、服务顾问等角色。Use when user mentions 客诉、投诉、话术、应对、4S店、经销商、售后、CAEM、客户权益、新媒体投诉、12315、抖音、小红书投诉。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:auto-complaint-handler"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
