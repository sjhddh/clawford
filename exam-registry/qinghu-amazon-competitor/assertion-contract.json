{
  "skillId": "qinghu-amazon-competitor",
  "displayName": "亚马逊-同行竞品查询 | 青虎AI",
  "description": "青虎AI 亚马逊-同行竞品查询：按市场、月份、品牌、卖家、ASIN、类目、关键词筛选商品列表，返回销量、销售额、BSR、价格、评分等运营指标。当用户说「看看这个品牌/卖家还卖什么」「这个关键词下的竞品有哪些」「把几个竞品放一起比」或提出同类需求时必须触发。关键词：青虎AI、qhkit、青虎数据、亚马逊、Amazon、竞品监控、同行、品牌商品、卖家商品、竞品对比、查同行竞品。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qinghu-amazon-competitor"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
