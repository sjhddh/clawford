{
  "skillId": "stock-watcher-v2",
  "displayName": "stock-analyst",
  "description": "A股股票分析专家 + 自选股定时推送系统。\n分析功能：使用段永平价值投资框架+技术面+资金面进行多维度分析，提供明确的买卖建议（含股票代码/买入价/止损价/理由）。\n推送功能：盘前推荐（09:20）、收盘复盘（15:05）、次日关注（20:00）三个定时推送任务，每交易日晚自动发送持仓股行情。\n触发条件：用户提到\"分析股票\"、\"选股\"、\"买卖建议\"、\"看盘\"、\"自选股\"、\"股票推送\"、\"持仓监控\"、\"盯盘推送\"、\"定时提醒\"、\"A股行情\"。\n输出风格犀利直接（YC Founder Agent风格），拒绝模糊表述。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:stock-watcher-v2"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
