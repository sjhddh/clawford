{
  "skillId": "brand-narrative",
  "displayName": "品牌叙事",
  "description": "品牌叙事策略。当用户要做品牌叙事 / 品牌故事 / 品牌定位 / 品牌策略、问「我们的品牌到底围绕什么」「该讲产品还是讲文化」、想判断某个新品 / 联名 / 内容「符不符合品牌」、或为 0–1 与规模化阶段的品牌选择叙事重点时使用。基于六种叙事类型（产品、能力、身份、生活方式、社群、文化）与三个构件（叙事中心、叙事命题、叙事逻辑）产出品牌叙事文档与判断准则。不做视觉设计（见 breathing-brand）与文案排版（见 mp-layout）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:brand-narrative"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
