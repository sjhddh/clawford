{
  "skillId": "tech-evolution-timeline",
  "displayName": "技术演进",
  "description": "技术演进、技术发展史。当用户说「这个技术是怎么发展过来的」「最早的专利是谁申请的」「技术演进路线」「写综述要技术发展脉络」「每个阶段的代表专利」时使用。输出技术演进时间线（Markdown）和代表专利表（Excel 能打开）。 Tells the story of a technology from its earliest patents to today, in stages with key patents, the problem each solved and who drove it, as a sourced timeline.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:tech-evolution-timeline"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
