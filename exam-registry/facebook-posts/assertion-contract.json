{
  "skillId": "facebook-posts",
  "displayName": "Facebook主页帖子批量提取",
  "description": "Facebook 主页帖子批量提取工具。用户只需提供 Facebook 账号主页 URL，即可拉取该主页近期帖子：正文、点赞、评论、图片/视频链接、发布时间、链接与作者信息，支持逐页翻页，表格呈现。适用于竞品账号内容拆解学习、创作者作品存档、素材搬运二次剪辑、自营账号备份、达人合作背调等场景。当用户需要提取、抓取、拉取 Facebook 主页帖子列表时使用。触发词：Facebook帖子、Facebook账号学习、FB主页帖子、脸书帖子提取、facebook posts、FB帖子。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:facebook-posts"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
