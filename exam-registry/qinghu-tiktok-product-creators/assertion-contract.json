{
  "skillId": "qinghu-tiktok-product-creators",
  "displayName": "TikTok-商品带货达人 | 青虎AI",
  "description": "青虎AI TikTok-商品带货达人：按 product_id 查询带过这个商品的达人列表（达人明细需再查达人详情）。当用户说「这个商品是哪些达人在带」「找带过这款的达人」「竞品的带货达人」或提出同类需求时必须触发。关键词：青虎AI、qhkit、青虎数据、TikTok、TikTok Shop、抖音国际版、带货达人、达人建联、商品达人、商品关联带货达人列表。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qinghu-tiktok-product-creators"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
