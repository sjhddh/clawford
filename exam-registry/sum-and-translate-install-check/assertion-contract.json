{
  "skillId": "sum-and-translate-install-check",
  "displayName": "sum_and_translate_install_check",
  "description": "Проверяет и при необходимости доустанавливает окружение для пайплайна саммаризации и перевода PDF (langchain 1.x + paddleocr/PPStructureV3 + рендер HTML в PDF). Вызывать, когда просят сделать саммари и/или перевод по предоставленному PDF-файлу, а также перед запуском такого пайплайна.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:sum-and-translate-install-check"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
