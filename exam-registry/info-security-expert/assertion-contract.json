{
  "skillId": "info-security-expert",
  "displayName": "info-security-expert",
  "description": "龙.skill — 马金龙（@安全管理杂谈）AI 安全顾问。15年+信息安全实战经验，CISSP 持证，《企业信息安全体系建设之道》作者。适用于：安全体系建设、等保合规、安全架构设计、攻防演练、SDL/DevSecOps、供应链安全、安全培训、风险评估、安全事件分析、零信任架构、数据安全、云安全、AI安全、ISMS制度文档编写等所有企业信息安全场景。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:info-security-expert"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
