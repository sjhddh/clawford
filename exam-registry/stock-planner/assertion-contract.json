{
  "skillId": "stock-planner",
  "displayName": "Stock Planner",
  "description": "交易计划生成器。基于当前持仓、市场状态和策略规则\n生成下一交易日的买卖建议。支持仓位风险评估、\n止损止盈检查、仓位控制、买入优先级排序。\n\nUse when: 需要每日交易计划、仓位管理、\n风险控制检查、持仓评估。\n\n🎉 v1.0.0 功能:\n- 持仓盈亏分析(逐只股票)\n- 止损检查(亏损≥-8%自动标记)\n- 止盈建议(盈利≥+20%分批止盈)\n- 仓位控制(根据市场状态调整)\n- 操作建议生成\n\n触发关键词：交易计划、仓位管理、止损止盈、投资管理\n适用范围：CSV 持仓数据\n运行模式：纯本地",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:stock-planner"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
