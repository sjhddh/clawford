{
  "skillId": "github-workflow-integration",
  "displayName": "github-workflow-integration",
  "description": "GitHub 工作流集成 — 纯 stdlib CLI 包装 GitHub REST API：开 PR / 列 PR / 查 commit status / Git Data API 推文件（blob→tree→commit→ref）。令牌从环境变量 GITHUB_TOKEN 读取，零存储零打印。当你想脚本化\"提 PR / 推文件到远端分支 / 查 CI 状态\"又不想装 git+gh 时使用；触发词：github-pr、开 PR、推送文件、commit status、CI 状态查询。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:github-workflow-integration"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
