{
  "skillId": "clawec-amazon-aba-selection",
  "displayName": "clawec-amazon-aba-selection",
  "description": "通过 ClawEC API 进行亚马逊 ABA 选品（按类目与时间维度分析 ABA 市场趋势，发现热门与异动关键词，支持搜索模式筛选与 AI 解读）。在用户需要 ABA 选品、亚马逊 ABA 选品、market trend、市场趋势选品、/tool/market-trend-analysis 时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:clawec-amazon-aba-selection"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
