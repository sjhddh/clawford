{
  "skillId": "email-validity-check-zh",
  "displayName": "邮箱有效性检查，验证邮箱地址格式，有效和无效状态。帮助销售团队、招聘人员、市场营销人员验证邮箱有效性、降低邮件退信率、提升外联与冷启动效率——是 CRM数据清洗、候选人筛查、供应商核验、邮件列表清洗的必备工具，适用于外贸邮件群发前清洗、招聘背调与采购商核实。",
  "description": "核验邮箱地址的真实可用状态，逐条返回邮箱验证结果以及判定原因，清理无效邮箱数据，降低外贸邮件群发退信概率，完成邮件列表合规清洗。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:email-validity-check-zh"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
