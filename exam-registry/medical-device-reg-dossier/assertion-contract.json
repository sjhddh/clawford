{
  "skillId": "medical-device-reg-dossier",
  "displayName": "医械注册申报资料编写",
  "description": "医疗器械注册申报资料编写助手——按市场结构汇编可提交的注册申报资料：中国 NMPA 注册、美国 FDA注册（510(k)/eSTAR）、欧盟 MDR、日本 PMDA 及全球协调路径。以 IMDRF STED 六章为骨架，映射各市场 Annex 章节，输出综述、研究资料、临床评价、标签等模块，并给出注册分类判定与资料清单梳理。生成后用 medical-device-compliance-grader 的 C1 维度自测。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:medical-device-reg-dossier"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
