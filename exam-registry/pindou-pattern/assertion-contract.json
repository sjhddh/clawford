{
  "skillId": "pindou-pattern",
  "displayName": "拼豆图纸生成器",
  "description": "生成拼豆图纸（perler bead pattern，简易版）。把任意图片或像素数据量化为真实拼豆色号的拼豆施工图——输出可缩放/可打印的 SVG 图纸（格内色号、行列坐标、每 10 格加重线、配色清单）+ HTML 预览 + CSV 物料清单 + JSON 网格。内置 205 色 × 5 品牌（MARD/COCO/漫漫/盼盼/咪小窝）色号对照，纯标准库、零外部依赖。当用户提到拼豆、拼豆图纸、色号、把图片转成 N×N 拼豆、像素画导出、串珠/珠子图案、perler bead pattern、bead pattern 时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:pindou-pattern"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
