{
  "skillId": "subcontractor-qualification-check-free",
  "displayName": "分包商资质与安全许可核对（免费版）",
  "description": "分包商资质与安全许可台账逐项核对，本免费版执行引擎声明的 6 项检查（证件有效期覆盖、资质等级匹配、人员证件一致性、重复登记、合同金额勾稽、空白占位符日期格式状态非法），每条结论引用原文行号与日期，材料不足只报缺什么不给结论。触发词包括 分包商资质与安全许可核对、分包商资质台账、资质与安全许可台账、分包商证件过期、特种作业人员证件核对、每月资质复核。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:subcontractor-qualification-check-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
