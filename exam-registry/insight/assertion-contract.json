{
  "skillId": "insight",
  "displayName": "insight",
  "description": "用户需求洞察与产品机会分析技能，适用于新产品开发、营销策划、品类切入前的市场分析。基于三段式提示词框架与四段式洞察到创业落地框架：用户画像识别（避开抓住所有人的陷阱，按复购频次、抗周期性与成瘾性判断核心用户）、情绪动机挖掘、洞察转机会、创业落地。帮你快速理解目标用户、挖掘情绪动机、把洞察转成可落地的产品机会，10 分钟完成传统方法需要数周的分析，产出可直接用于产品设计和营销文案的具体画面。同时覆盖一人公司与小团队的极简创业落地（《小而美》方法论）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:insight"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
