{
  "skillId": "agency-portal",
  "displayName": "agency-portal",
  "description": "代运营客户自助门户+管理员后台,提供租户登录/注册/套餐/素材/报告/续费/审批/反馈/平台绑定/配额/计费/品牌管理/数据统计/竞品监控/数字人/充值等187个MCP工具(server.py @mcp.tool实测)+199个HTTP handler(portal_server.py _handle_方法)。触发: 租户入驻/续费/素材管理/内容审批/巡检/反馈处理/配额查询/账单/品牌管理/数据统计/竞品监控/数字人/充值",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:agency-portal"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
