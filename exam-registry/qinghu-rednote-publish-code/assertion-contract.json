{
  "skillId": "qinghu-rednote-publish-code",
  "displayName": "小红书-种草码生成 | 青虎AI",
  "description": "青虎AI 小红书-种草码生成：把标题、正文、图片或视频生成小红书种草码，浏览器扫码一键跳转小红书并自动加载笔记内容。当用户说「帮我生成小红书种草码」「把这篇文案做成扫码发布小红书」或提出同类需求时必须触发。关键词：青虎AI、qhkit、青虎数据、小红书、RedNote、xhs、种草码、扫码发布、一键发笔记、小红书种草码。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qinghu-rednote-publish-code"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
