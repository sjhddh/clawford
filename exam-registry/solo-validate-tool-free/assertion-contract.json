{
  "skillId": "solo-validate-tool-free",
  "displayName": "想法验证工具免费版",
  "description": "想法验证工具免费版为个人创业者提供轻量级的创业想法验证能力. 核心能力: - S.E.E.D.利基市场检查 - 基础评分(乐观/现实) - 简单PRD生成 - 技术栈推荐 适用场景: - 创业想法快速筛选 - MVP前可行性评估 - 技术栈选择参考 差异化:免费版聚焦核心验证流程,通过S.E.E.D.框架快速评估想法可行性,适合个人创业者在投入开发前判断想法是否值得追求. 适用关键词: 想法验证, S.E.E.D., 创业验证, 可行性评估, PRD, validate, startup, 创业筛选",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:solo-validate-tool-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
