{
  "skillId": "pikpak-storage-report",
  "displayName": "pikpak-storage-report",
  "description": "Report what is filling a PikPak drive: folder sizes, file counts and largest files, without deleting anything. 空间体检只读，不把扫描字节当配额。 Triggers: PikPak 容量不足, ストレージ不足, 容量がいっぱい, PikPak 용량 부족, 저장 공간 부족, 空間不足, 大文件, 大きいファイル.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:pikpak-storage-report"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
