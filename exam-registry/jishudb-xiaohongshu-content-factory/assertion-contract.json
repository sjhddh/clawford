{
  "skillId": "jishudb-xiaohongshu-content-factory",
  "displayName": "Xiaohongshu Content Factory / 小红书图文创作工厂",
  "description": "Create complete Xiaohongshu posts, title options, and finished PNG/JPEG covers; retain sources and revisions in JishuDB. No automatic publishing. / 制作完整小红书文案、标题和PNG/JPEG成品封面，来源与修订保存在JishuDB，不自动发布。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:jishudb-xiaohongshu-content-factory"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the generated content align with the requested scope and structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate output quality against explicit criteria?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "contentGenerator_run_{{rand}}"
      ]
    }
  }
}
