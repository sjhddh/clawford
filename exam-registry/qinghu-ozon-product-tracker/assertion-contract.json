{
  "skillId": "qinghu-ozon-product-tracker",
  "displayName": "Ozon-商品信息追踪 | 青虎AI",
  "description": "青虎AI Ozon-商品信息追踪：按商品 ID 追踪价格变化、评论数、评分、竞品跟卖和变体（默认 30 天，最多 90 天）。当用户说「这个 Ozon 商品最近改价了吗」「有没有人跟卖」「评论增长情况」或提出同类需求时必须触发。关键词：青虎AI、qhkit、青虎数据、Ozon、俄罗斯电商、价格追踪、跟卖监控、评论增长、商品信息追踪。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qinghu-ozon-product-tracker"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
