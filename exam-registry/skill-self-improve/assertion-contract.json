{
  "skillId": "skill-self-improve",
  "displayName": "skill-self-improve",
  "description": "给任意 WorkBuddy 技能注入「自进化学习系统」，让它越用越好用、越用越高效。 通过通用 learner.py 记录每次使用的成败与用户偏好，自动复盘并给出改进建议。 一键批量注入：复制学习模块、初始化记忆文件、在 SKILL.md 追加自进化章节。 适用：准备发布或已上线的技能、想加自我迭代能力的任何技能。 触发词：自进化、自我复盘、自动迭代、越用越好用、学习系统、skill 自我改进。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:skill-self-improve"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
