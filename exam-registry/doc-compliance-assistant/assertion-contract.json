{
  "skillId": "doc-compliance-assistant",
  "displayName": "doc-compliance-assistant",
  "description": "文档合规处理助手 — 清洗+合规扫描一体：编码探测/BOM/换行/空白归一化后，一次扫描 PII（邮箱/手机号/身份证）、密钥（GitHub/AWS/OpenAI/私钥）、URL 内嵌口令，输出脱敏命中报告。当你要发布/外发/归档文档前做合规自检时使用；触发词：doc-compliance、文档合规、发前扫描、PII 扫描、密钥泄漏检查。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:doc-compliance-assistant"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
