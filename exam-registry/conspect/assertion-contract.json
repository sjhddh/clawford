{
  "skillId": "conspect",
  "displayName": "conspect",
  "description": "多源数据智能分析与专业报表生成工具。上传 Excel/CSV 数据源，AI 走「读取数据 → 分析数据 → 汇报内容选型 → 报表选型 → 生成报表」五阶段流程：先摸清数据、再算出结论、再定「讲什么」、再定「长什么样」、最后出报表。内置 38 种报表风格资产（6 族）与 22 个报表板块，两个选型环节各有一次用户确认。适用场景：经营分析、周报月报、数据看板、投屏报表、多表合并分析、Excel 出图。不适用：桌面 BI 集成、实时数据接入、纯文本报告、原始数据在线编辑。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:conspect"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
