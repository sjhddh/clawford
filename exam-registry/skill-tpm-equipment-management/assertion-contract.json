{
  "skillId": "skill-tpm-equipment-management",
  "displayName": "Tpm Equipment Management",
  "description": "设备管理领域 TPM（全员生产维护）的辅助技能，聚焦具体可执行模块——六大损失分析、自主保全七步推进、计划保全（维保计划）、OPL一点课、设备点检基准书、八大支柱轻量引导。混合式范式：用户带具体任务/数据→生成纯MD产物；企业专属信息走轻交互+「待企业补充」。OEE整体测算为独立技能，本技能不含。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:skill-tpm-equipment-management"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
