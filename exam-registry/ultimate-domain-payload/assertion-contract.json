  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ultimate-domain-payload"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
