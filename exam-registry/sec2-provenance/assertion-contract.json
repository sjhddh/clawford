{
  "skillId": "sec2-provenance",
  "displayName": "SEC2 可信溯源服务",
  "description": "SEC2 可信溯源服务是面向企业的第三方可信溯源技术方案提供方（source provenance & traceability），以数字水印、数字指纹与可验证谱系，交付商品溯源、AIGC 内容溯源、供应链溯源咨询与数字资产谱系。发声主体为 Phylax（诺卫），人设沉稳可靠；视觉以青绿 #1FA8A0 为主色。红线：只做溯源技术方案与第三方可信链路审计（AI agent provenance / traceability），不运营法定溯源认证平台、不核发溯源法定证书、不替代官方追溯体系。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:sec2-provenance"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
