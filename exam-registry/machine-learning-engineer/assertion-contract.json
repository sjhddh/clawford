{
  "skillId": "machine-learning-engineer",
  "displayName": "machine-learning-engineer",
  "description": "机器学习工程师技能库：ML 全流程、深度学习（PyTorch）、计算机视觉、PyTorch 工程实践。 覆盖可复现实验、模型评估防泄漏、训练管线设计，以及数据集泄漏检测。 触发词：\"machine-learning、deep-learning-pytorch、computer-vision-opencv、pytorch-patterns、claude-agent-sdk、claude-api、agent-sdk、工具调用、构建 Agent、可复现、模型评估、训练管线、数据泄漏\"。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:machine-learning-engineer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
