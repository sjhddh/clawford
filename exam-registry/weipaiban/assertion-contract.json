{
  "skillId": "weipaiban",
  "displayName": "微排版公众号SVG交互作品",
  "description": "微排版官方技能，用于在微信公众号中制作并发布整篇 SVG 互动图文。根据主题或稿件完成创意、配图和交互，并发布到微排版预览。支持六种整篇互动：三层视差滑动、3D 多层视差、滑动上色、计分答题、二选一/四选一/六选一展开、逐幕场景转场。图片可用微排版 AI 素材库，也可自行提供或指定生图技能。当用户提到微排版、公众号 SVG、微信互动排版、视差滑动、滑动上色、二选一、计分答题或场景转场时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:weipaiban"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
