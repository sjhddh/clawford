{
  "skillId": "wangqingshui",
  "displayName": "忘情水会问版（禅意情感治愈类）",
  "description": "孟婆汤叙事引擎调用封装技能。当用户需要复用、生成、调用或扩展\"孟婆汤\"独白文案与分享卡片时使用.\n本小程序是一款情感记录工具，使用者可选择不同记忆主题，填写想记录的人或事件，生成专属记忆故事和分享卡片。使用者填写的内容仅用于生成当前页面展示效果，可保存在本地用于再次查看，不上传服务器，不用于其他用途。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:wangqingshui"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
