{
  "skillId": "cue-insurance-marketing",
  "displayName": "保险营销",
  "description": "用 Cue 跑「保险营销」场景的深度研究：横向比对目标保险产品与竞品在保障、收益、服务与适配场景上的差异，扫描热点事件自动映射保险需求。覆盖保险产品对比指南、保险营销线索日报、产品适当性核查、条款核查、合规红线速查等核心搭子，产出可直接用于客户沟通的选型对比、朋友圈文案与营销线索，守住「可如实说明」的合规边界。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:cue-insurance-marketing"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
