{
  "skillId": "vc-diligence-decision",
  "displayName": "VC 尽职调查与投资决策",
  "description": "VC 尽职调查与投资决策专家。当用户需要为项目生成五维尽调清单、三档情景估值模型，或撰写IC投委会备忘录（投资亮点/风险/估值建议/推荐动作）时使用。在为风险投资交易制作DD清单、估值模型或IC备忘录时，应使用此技能。\n把 VC 流水线的「尽职调查 → 投资决策」环节标准化：产出五维尽调清单、三档情景估值模型、IC 投委会 Memo，关键节点保留人工决策（HITL）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:vc-diligence-decision"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
