{
  "skillId": "okdata-weibo",
  "displayName": "微博数据助手 okdata",
  "description": "Public Weibo data through okdata: posts, trending board, accounts, comment replies, backup. 11 endpoints, $0.002–$0.0025 a call. Use when a task needs Weibo data. 通过 okdata 取微博公开数据：帖子、热榜、账号、评论回复、backup。11 个接口，每次 $0.002–$0.0025。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:okdata-weibo"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
