{
  "skillId": "lottery-bark-check",
  "displayName": "彩票开奖核对推送",
  "description": "中国彩票开奖核对与 Bark 推送技能。必须配合 Bark App 使用：抓取中彩网（双色球）与 500 网（大乐透）官方最新开奖，与用户守号比对，判定奖级与金额，按定稿蓝黑版式生成报告，并通过 Bark 推送（group 固定「彩票」，需自备 Bark device_key）到手机，每天定时核对不漏期。关键词：彩票、双色球、大乐透、开奖号码、守号核对、中奖查询、Bark 推送、Bark device_key、开奖提醒、定时提醒。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:lottery-bark-check"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
