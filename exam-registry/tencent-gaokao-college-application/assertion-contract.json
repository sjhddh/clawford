{
  "skillId": "tencent-gaokao-college-application",
  "displayName": "腾讯高考志愿填报",
  "description": "面向中国普通高考常规批次考生的腾讯高考志愿填报工具。用于查询一分一段、省控线、院校或专业历年录取数据，以及根据省份、分数、位次、选科和偏好生成院校优先或专业优先的冲稳保志愿参考方案及 HTML 报告；涉及高考成绩、位次、院校专业录取线、招生计划、选科限制或志愿填报时应使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:tencent-gaokao-college-application"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
