{
  "skillId": "ue5-automation",
  "displayName": "UE5 Blueprint Automation",
  "description": "UE5 Blueprint Automation (UE5 蓝图自动化): let AI read/write UE5 Blueprint graphs, compile with structured node_guid diagnostics, verify PIE runtime behavior, and undo at task level. Requires the ue5-automation bridge/MCP; Windows, UE 5.1/5.8. 本地 bridge 使用本机 token，无需外部 API Key。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ue5-automation"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
