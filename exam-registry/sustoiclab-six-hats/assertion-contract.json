  "description": "六顶思考帽 · Su's StoicLab。当用户需要从多个角度全面思考问题、做决策分析、或引导团队讨论时使用。通过白帽(事实)->红帽(直觉)->黑帽(风险)->黄帽(价值)->绿帽(创新)->蓝帽(收束)六轮引导，帮助用户看清全局。原创作品 by 苏庶 @ 钝感实验室。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:sustoiclab-six-hats"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
