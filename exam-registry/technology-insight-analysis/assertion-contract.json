{
  "skillId": "technology-insight-analysis",
  "displayName": "technology-insight-analysis",
  "description": "面向任意技术领域的竞争技术洞察分析。输入已检索、筛选、标引的专利数据，自动执行技术路线分析、竞争格局评估、战略机会识别，生成管理层可读的 HTML 可视化洞察报告。适用于固态电池、半导体、生物医药、新能源、化工等任意技术赛道的专利竞争分析与技术白皮书生成。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:technology-insight-analysis"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
