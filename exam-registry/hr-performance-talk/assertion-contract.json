{
  "skillId": "hr-performance-talk",
  "displayName": "绩效反馈话术台",
  "description": "绩效沟通最怕两件事：主管只会念分数，员工听完只记住「我不行」；或者绕圈子，问题没点破。 输入：员工岗位与职级、本期目标与实际结果、具体事实（做得好/待改进各 2-3 条）、结果等级、发展意向。输出：①开场框架（先对齐目标，再谈事实）②事实陈述（只讲行为与结果，带数据）③待改进项的讨论话术（提问式而非宣判式）④下阶段目标（3 条以内、可衡量）⑤员工可能的三类反应与应对 ⑥记录模板与后续跟进节点。永久免费，无需付费、无需授权（MIT-0）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:hr-performance-talk"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
