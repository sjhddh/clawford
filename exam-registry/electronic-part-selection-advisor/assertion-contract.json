{
  "skillId": "electronic-part-selection-advisor",
  "displayName": "元器件选型与替代料顾问",
  "description": "元器件选型与替代料顾问。当用户需要做 BOM 选型、找替代料/代换料、比对型号的参数与封装、评估温度范围与生命周期、查交期与价格、判断供应链风险、消化呆滞库存时使用。触发词：选型、替代料、代换、BOM、物料核对、规格书、交期、问价、呆滞库存、国产替代、供应链风险、假货/散新。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:electronic-part-selection-advisor"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
