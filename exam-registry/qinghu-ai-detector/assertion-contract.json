{
  "skillId": "qinghu-ai-detector",
  "displayName": "AI检测专家 | 青虎AI",
  "description": "青虎AI AI生成内容检测：对文案、文章、商品描述等文本检测 AI 生成占比与分段明细，对商品图、海报、模特图等图片检测 AI 生成置信度，给出综合判定，并按需给出降低 AI 痕迹的建议。当用户要检测文本或图片是不是 AI 生成、查 AI 率、判断素材真伪、发布前自查 AI 痕迹、核验供应商或达人交付的素材时必须触发。关键词：青虎AI、AI检测、AIGC检测、AI率、AI生成文本检测、AI生成图片检测、真伪判定、降AI、AI味、内容审核。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qinghu-ai-detector"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
