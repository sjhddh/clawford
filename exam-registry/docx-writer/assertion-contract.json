{
  "skillId": "docx-writer",
  "displayName": "docx-writer",
  "description": "标准学术文档生成 — 通过 bayoo-docx（原生脚注支持）和模板 template.docx 生成符合学术排印规范的 Word 文档，含脚注、三线表、图片、LaTeX 公式（可输出 Word 原生可编辑公式 OMML 或 XeLaTeX 渲染图）等。当用户要生成/排版 Word（.docx）文档、学位论文、实验报告、新闻稿、推送稿、讲稿，或需要在 docx 里插入数学公式/LaTeX 公式/原生可编辑公式时使用",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:docx-writer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
