{
  "skillId": "gdrive-connect-pro",
  "displayName": "gdrive-connect-pro",
  "description": "Kết nối Google Drive/Sheets trong 1 câu: agent in link uỷ quyền OAuth, người dùng bấm Allow + dán mã, agent lưu phiên làm việc và test tạo/ghi/format Sheet thật. Dùng được cho cả Gmail cá nhân và Google Workspace, không cần gcloud, không cần vào Cloud Console.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:gdrive-connect-pro"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
