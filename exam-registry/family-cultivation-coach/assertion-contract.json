{
  "skillId": "family-cultivation-coach",
  "displayName": "Family Cultivation Coach",
  "description": "家庭培养协作官：在用户明确要求制定或调整孩子每周培养计划、检查课表冲突、生成家庭复盘时，收集最少必要信息并输出可执行课表、建议和风险提醒。默认只在当前会话生成内容，不保存、上传或推送孩子与家庭数据；只有用户明确选择飞书或 Notion、完成安全配置并逐次确认具体读写范围后，才使用外部存储。Follow/关注作者：...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:family-cultivation-coach"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
