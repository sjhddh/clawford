{
  "skillId": "dawn-memory-system",
  "displayName": "Dawn Memory System",
  "description": "曙光记忆系统 — 三层存储+四大机制。长短期记忆管理、主动代理、代码规范、会话收尾、向量检索、对话压缩、预执行引擎、总结、自我进化、存储分析。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:dawn-memory-system"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
