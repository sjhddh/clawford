{
  "skillId": "school-bus-safety-check-free",
  "displayName": "校车运行与安全检查记录核对（免费版）",
  "description": "校车运行与安全检查记录材料逐项核对，本免费版执行 6 项检查（出车检查记录覆盖、检查项目齐全性、驾驶员资格有效期、同一车辆同一日期重复登记、合计行逐列复核、空白与格式检测），每条结论引用原文行号，材料不足不给结论。触发词包括 校车运行与安全检查记录核对、校车出车检查记录、校车驾驶资格到期、照管人员交接记录、校车运行记录对不上。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:school-bus-safety-check-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
