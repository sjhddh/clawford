{
  "skillId": "skill-skeleton-generator",
  "displayName": "Skill Skeleton Generator（技能骨架生成器）",
  "description": "One-command generator for LGD-compliant AI skill skeletons (SKILL.md + AGENTS.md + dirs) with full frontmatter scaffolding. 一键生成符合 LGD 三律/四角度合规的新技能骨架（SKILL.md + AGENTS.md），规范化 frontmatter 起步。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:skill-skeleton-generator"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
