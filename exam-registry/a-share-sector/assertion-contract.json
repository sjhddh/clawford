{
  "skillId": "a-share-sector",
  "displayName": "A Share Sector",
  "description": "查询 A 股行业/概念/地域板块的涨跌与资金流向，支持当天实时与指定历史日期（--date）； 输出涨跌幅、成交量、主力流入、主力流出，以及板块内个股详情（detail 支持 --hot 双视图）。 数据来自东方财富（akshare）。当用户问 A股板块、行业板块、概念板块、板块涨跌、板块资金流、 换手率、成交量、主力净流入、流入流出、某日板块表现、板块里哪些股票涨得好或资金量大时使用； 须优先执行 scripts/query.py，禁止手写爬虫。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:a-share-sector"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
