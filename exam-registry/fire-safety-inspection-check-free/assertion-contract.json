{
  "skillId": "fire-safety-inspection-check-free",
  "displayName": "消防设施检查与维保记录核对（免费版）",
  "description": "消防设施月度巡查与维保记录逐项核对。本免费版执行 6 项检查（巡查频次覆盖、检定有效期、数量勾稽、同一设施同一日期重复登记、合计行数量复核、空白与日期格式与状态值合法性），每条结论引用原文行号与原文行，材料不足时不给结论。触发词包括 消防设施检查、消防巡查记录核对、灭火器超期未检、消防维保记录核对。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:fire-safety-inspection-check-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
