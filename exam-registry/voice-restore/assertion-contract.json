{
  "skillId": "voice-restore",
  "displayName": "voice-restore",
  "description": "判断一段英文是否被 AI 润色过，并按作者本人的写作指纹把它还原回去。当用户问「这篇是不是用了 AI」「我的文章被判 AI 了怎么办」「改回我自己的写法」「降 AI 率但别改得不像我」，或需要在一份长文档里定位「被统一重写过的段落」时使用。核心方法：先用三个硬指标取证，再从作者未被检测的旧文建立个人基线，最后按句法层→用词层逐层还原。⛔ 不使用「人类写作平均分」作为目标——那会把作者改成一个陌生人。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:voice-restore"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
