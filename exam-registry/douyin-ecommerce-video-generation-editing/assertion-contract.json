{
  "skillId": "douyin-ecommerce-video-generation-editing",
  "displayName": "抖音电商视频生成与编辑",
  "description": "为抖音电商、抖店、商品卡和直播间生成与编辑商品页演示、SKU视频、直播讲解片段及千川投放素材。Use this skill for 抖音电商视频、抖店商品视频、商品卡视频、直播带货演示、千川广告、SKU批量视频、详情页功能说明和商品素材重制；支持 Seedance 与 AI Hive 自动交付。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:douyin-ecommerce-video-generation-editing"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
