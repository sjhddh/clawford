{
  "skillId": "tiktok-news-brief",
  "displayName": "TikTok新闻简报",
  "description": "TikTok新闻简报，一个关键词搜索综合/高赞视频，根据获得的实时数据进行信息聚合后生成智能摘要、热点聚类、舆情分析和深度解读报告，包含详细信息源列表，适用于AI agent进行TikTok社媒资讯分析。当用户需要新闻搜索、舆情分析、需求洞察、热点追踪、情报获取、资讯聚合、新闻解读、TikTok搜索、事件追踪、行业情报等场景时。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:tiktok-news-brief"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
