{
  "skillId": "xiaozhi-cross-subject-detective",
  "displayName": "跨学科侦探周",
  "description": "用一个真实主题在一周内串联多门学科，找出学科之间的联结。学生说\"跨学科侦探周\"、\"帮我联系不同学科的知识\"、\"丝绸之路能串哪些学科\"、\"我想做一个主题研究\"、\"历史和地理有什么关系\"时可激活。流程是选题→多视角→逐科深潜→建立联结→整理项目记录，产出写进概念图谱。它不做单科解题（转对应学科教练）、不做错题分析（转错题本）、不替学生写研究报告。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:xiaozhi-cross-subject-detective"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
