{
  "skillId": "bid-doc-interpreter",
  "displayName": "Bid Doc Interpreter",
  "description": "招标文件拆分解读。当用户上传招标文件（PDF/DOCX/图片/多文件）并表达\"解读招标文件\"\"拆解招标文件\"\"分析招标文件\"\"标书解读\"\"招标文件分析\"\"提取招标文件关键信息\"\"招标文件要点梳理\"\"看看这个标有什么坑\"等意图时触发。按7大模块（项目基本信息、资格性审查、符合性审查、商务要求、技术要求、废标项、评标办法与评分标准）+倾向性与排他性审查，结构化解读并输出标准化表格+要点清单+风险提示。不适用于合同审查、投标文件编制、评分/中标模拟预测、投标报价计算、质疑函/投诉书撰写——遇到此类请求应礼貌说明范围并引导至对应技能，不强行作答。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:bid-doc-interpreter"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
