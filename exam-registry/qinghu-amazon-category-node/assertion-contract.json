{
  "skillId": "qinghu-amazon-category-node",
  "displayName": "亚马逊-类目节点查询 | 青虎AI",
  "description": "青虎AI 亚马逊-类目节点查询：通过关键词、类目名称、节点路径或节点 ID 查亚马逊类目，返回层级路径、名称和商品数量；也是其他亚马逊工具 nodeIdPath 的来源。当用户说「××在亚马逊属于哪个类目」「查一下类目节点 ID」「这个类目下有多少商品」或提出同类需求时必须触发。关键词：青虎AI、qhkit、青虎数据、亚马逊、Amazon、类目节点、nodeId、nodeIdPath、类目层级、BrowseNode、查产品类目。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qinghu-amazon-category-node"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
