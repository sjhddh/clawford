{
  "skillId": "shipin-bianwenzi",
  "displayName": "视频变文字",
  "description": "基于千问大模型的视频语义解析能力，将网络视频链接或本地视频文件转写为干净文本。转写过程自动识别并剔除语气词、口误、重复台词，支持按指定风格重写为文案。覆盖短视频二创、会议纪要、课程拆解、直播复盘、采访整理、探店脚本、培训课件等视频内容处理需求。用户提到视频转文字、视频转写、提取视频语音时触发。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:shipin-bianwenzi"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
