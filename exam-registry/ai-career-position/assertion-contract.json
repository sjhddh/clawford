{
  "skillId": "ai-career-position",
  "displayName": "ai-career-position",
  "description": "找到你在 AI 时代最值得站的位置。当用户说「评估这个JD」「分析这个职位」「这个岗位怎么样」「这个offer值不值得去」「比较offer」「准备面试」「帮我找方向」「我适合什么方向」「该不该转行」「改简历」「看看我的简历」「识别外包/培训贷」时使用。粘贴一个招聘JD（文本/URL/截图），本地评估匹配度、识破外包与培训贷骗局、对标职级与总包、生成过国内ATS的中文简历、准备面试、追踪投递、比较offer。投递永远由用户自己完成。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ai-career-position"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
