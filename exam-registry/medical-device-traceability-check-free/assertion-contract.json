{
  "skillId": "medical-device-traceability-check-free",
  "displayName": "医疗器械UDI与出入库追溯核对（免费版）",
  "description": "医疗器械UDI与出入库追溯台账逐项核对（UDI 完整性、出入库勾稽、效期、重复登记、合计行复核、字段合法性 共 6 项），每条结论引用原文行号与原文行内容。本免费版执行引擎声明的这 6 项免费检查，完整档追加的 5 项不在本包内。触发词包括 医疗器械UDI与出入库追溯核对、UDI 台账对不上、器械追溯台账核对。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:medical-device-traceability-check-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
