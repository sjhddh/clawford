{
  "skillId": "personal-digital-asset",
  "displayName": "个人数字资产盘点管家",
  "description": "盘点一个人的数字资产（经验诀窍/模板/数据/工具/内容/设计/影响力/AI 资产），用 9 题自检打分，产出八字段资产卡；已授权时可操作 zengzhi.life 的 Agent 工作流（建单→素材→报告→展示页，止于公开展示之前）。触发词：个人数字资产、盘点、数字资产报告、知识变现、副业、经验变现、zengzhi.life，或问\"我有什么可以变成资产\"。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:personal-digital-asset"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
