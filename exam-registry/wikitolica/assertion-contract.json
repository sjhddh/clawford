{
  "skillId": "wikitolica",
  "displayName": "wikitolica-search",
  "description": "Busca y obtiene artículos de la Enciclopedia Católica Wikitólica (4400+ artículos en español sobre doctrina, santos, papas, teología, historia eclesiástica, liturgia, sacramentos, estudios bíblicos, etc.). Disponible en: www.wikitolica.com",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:wikitolica"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
