{
  "skillId": "ecommerce-master",
  "displayName": "ecommerce-master",
  "description": "电商全链路 AI Agent 技能库：跨境扩张策略（市场评分/税务合规/物流/支付本地化）、Stripe 支付集成（订阅/发票/风控/对账）、Shopify 产品管理（GraphQL/CSV 批量）、电商前端搭建（组件/SEO/移动适配）、淘宝/闲鱼运营（商品发布内容包/交易对账/评价维护/选品定价复盘）。当用户要做跨境电商选品与落地、接入 Stripe 订阅与催款、批量管理 Shopify 商品、运营淘宝或闲鱼店铺、或搭建高转化电商前端时调用本技能，并据路由表进入对应子技能。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ecommerce-master"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
