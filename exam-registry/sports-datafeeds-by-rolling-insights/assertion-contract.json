{
  "skillId": "sports-datafeeds-by-rolling-insights",
  "displayName": "Sports DataFeeds by Rolling Insights",
  "description": "DataFeeds by Rolling Insights delivers live scores, schedules, play-by-play, player and team stats, injuries, depth charts, and more across major sports. This skill helps agents use the service securely through the DataFeeds MCP server and REST API, with sport-specific guidance and workflows.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:sports-datafeeds-by-rolling-insights"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
