{
  "skillId": "xhs-note-analyzer",
  "displayName": "Xhs Note Analyzer",
  "description": "小红书作品分析助手。根据笔记ID或链接一键查询作品完整信息，并以专业创作者视角进行多维度深度分析，帮助高效了解作品全貌并获取可操作的优化建议。支持封面图视觉分析与账号定位判断，支持批量查询。触发词：小红书作品分析、查询小红书作品、获取小红书笔记数据、小红书内容分析、xhs笔记详情",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:xhs-note-analyzer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
