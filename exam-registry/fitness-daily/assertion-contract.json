{
  "skillId": "fitness-daily",
  "displayName": "Fitness Daily - 健身自律打卡",
  "description": "每日健身习惯固化成 4 组 15 项打卡清单，共享给你。勾选即出完成率与下周重点建议。\n身体活动：30 分钟中高强度运动 / 步数 ≥8000 / 拉伸 10 分钟\n营养与恢复：饮水 ≥2 升 / 蛋白质达标 / 蔬菜占一半 / 无深夜进食 / 睡眠 7–9 小时\n心理与习惯：冥想 5 分钟 / 屏幕时间 ≤2 小时 / 健康日志 / 阅读 15 分钟\n纪律底线：未饮酒或适量 / 未久坐超 1 小时 / 按计划执行不拖延",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:fitness-daily"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
