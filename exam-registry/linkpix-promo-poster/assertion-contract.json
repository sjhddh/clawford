{
  "skillId": "linkpix-promo-poster",
  "displayName": "电商促销海报生成器 | LinkPix",
  "description": "快速生成双11、黑五、圣诞节等营销活动海报与折扣营销图，适用于新品发布、促销活动及品牌宣传。当用户要求做促销海报、活动图、折扣图、节日营销图、大促素材时必须触发。关键词：LinkPix、qhkit、促销海报、活动海报、折扣图、营销图、双11、黑五、圣诞、618、大促素材、新品海报、品牌宣传图。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:linkpix-promo-poster"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
