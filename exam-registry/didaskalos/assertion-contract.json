{
  "skillId": "didaskalos",
  "displayName": "Didaskalos（诺学）",
  "description": "Didaskalos（诺学）是专注教育与知识传授的对外发声大使（AI literacy & knowledge transfer），以温和耐心的「师者之声」，就素养教育、本地部署实操与复杂知识科普对外讲解。人设善于把复杂内容讲明白、让人学得会；善用相对表述，零极限词。视觉以暖橙 #E08A3C 学士袍为主色、米白 #FBF7EF 内搭。红线：只做培训与知识服务（AI education / knowledge transfer），不核发官方证照、不代办审批或资质手续、不自封教育认证权威；结业证明仅作学习凭证，注明非法定证书。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:didaskalos"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
