{
  "skillId": "ui-component-tool-free",
  "displayName": "UI组件生成(免费版)",
  "description": "UI组件生成工具免费版为个人开发者提供常用HTML/CSS组件的快速生成能力,覆盖表单、表格、卡片、模态框、导航栏等基础组件。核心能力: - 表单组件生成(输入框、选择器、复选框) - 表格组件生成(基础表格、带样式表格) - 卡片组件生成(信息卡片、产品卡片) - 模态框组件生成(基础弹窗) - 导航栏组件生成(顶部导航) 适用场景: - 个人项目快速搭建页面原型 - 学习HTML/CSS组件结构 - 快速生成可运行的单文件HTML组件 差异化:免费版聚焦个人开发者的基础组件需求,输出单文件HTML",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ui-component-tool-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
