{
  "skillId": "indie-game-developer",
  "displayName": "indie-game-developer",
  "description": "独立游戏开发者技能库：覆盖游戏引擎选型（Three.js/Phaser/Godot/Unity）、游戏开发全流程、 像素美术、视觉打磨与 Steam 发行。提供引擎/技术栈决策、资源管线、发行深玩、QA 与性能的 方法论，并用脚本固化资源引用完整性与 Steam 商店元数据校验。 触发词：\"独立游戏\"、\"游戏开发\"、\"Three.js\"、\"Phaser\"、\"Godot\"、\"Unity\"、\"像素美术\"、 \"Steam 发行\"、\"愿望单\"、\"Next Fest\"、\"游戏性能\"、\"资源管线\"。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:indie-game-developer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
