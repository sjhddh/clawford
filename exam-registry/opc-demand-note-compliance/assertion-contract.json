{
  "skillId": "opc-demand-note-compliance",
  "displayName": "Opc Demand Note Compliance",
  "description": "即期本票从签发到结算的全流程合规管控工具，含合同要素清单、文件验证、案例库、机构图谱四大模块。当用户提到即期本票、本票合规、本票验证、票据法、demand note、promissory note、票据背书、本票合同、SWIFT报文验证、本票骗局、真票假结、空头本票等与即期本票相关的需求时使用此技能。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:opc-demand-note-compliance"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
