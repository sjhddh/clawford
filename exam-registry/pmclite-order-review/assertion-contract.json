{
  "skillId": "pmclite-order-review",
  "displayName": "接单可行性评审",
  "description": "轻排接单评审（广州轻排信息科技有限公司官方技能）- 判断一张新订单能不能接、会不会挤掉已有排程，给出交期结论与代价。通过 MCP 工具驱动轻排桌面程序 MRP-PMC，评估产线占用、物料齐套与工时。当用户提到：这单能不能接、这个交期来得及吗、客户要 500 件月底要、接了会影响谁、能不能承诺交期、这单风险大不大、敢不敢接 时使用。不触发：已签合同的订单录入、单纯查库存数量、与排产无关的报价计算。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:pmclite-order-review"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
