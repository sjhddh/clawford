{
  "skillId": "hr-interview-kit",
  "displayName": "面试题库与评分表",
  "description": "面试最容易变成闲聊：问得随意、评分靠感觉、几个面试官打分口径不一致，最后比的是印象而不是能力。 输入：岗位与核心能力项、候选人级别、面试轮次与时长、需要重点考察的 3 项能力。输出：①能力项与题目对照表 ②每题的行为面试题（STAR 式）+ 2 个追问 ③评分锚点（1/3/5 分各是什么表现）④面试官记录模板 ⑤红旗信号清单（哪些回答需要警惕）。永久免费，无需付费、无需授权（MIT-0）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:hr-interview-kit"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
