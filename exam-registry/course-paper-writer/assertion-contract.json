{
  "skillId": "course-paper-writer",
  "displayName": "Course Paper Writer · 课程论文写作",
  "description": "写课程论文、结课论文、期末论文、读书报告、文献综述时使用。先读作业要求文件（.docx/.pdf）提取字数、字体行距、文献篇数与年限、案例数、标题层级等硬约束，再检索文献、联网取证、标注出处，最后生成排版正确的 .docx 并自报字数与页数。覆盖选题拆解、文献检索、结构设计、AI 文风清理、引用格式（GB/T 7714 等）与交稿前自查，适用于思政、工程伦理、专业课、公选课等任何有格式硬性要求的学术写作任务。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:course-paper-writer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
