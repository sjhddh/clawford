{
  "skillId": "auto-insurance-compare",
  "displayName": "车险方案对比台",
  "description": "车险报价单表述不一：保额、免赔额、免责条款、增值服务都不一样，光比总价容易买错。 输入：车辆信息（车价/年限/用途）、驾龄与出险记录、已有报价要点、关注点（价格/保障范围/服务）。输出：①口径统一对比表（交强险/车损/三者/座位/附加险的保额与免赔）②免责条款要点（哪些情况不赔）③按用车场景的配置建议（新车/老车/长途/城市代步）④增值服务对比（救援/代驾/换胎）⑤投保与理赔注意（报案时限、现场证据、定损复核）。永久免费，无需付费、无需授权（MIT-0）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:auto-insurance-compare"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
