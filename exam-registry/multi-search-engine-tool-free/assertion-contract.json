{
  "skillId": "multi-search-engine-tool-free",
  "displayName": "多搜索引擎免费版",
  "description": "多搜索引擎免费版,为个人用户提供多搜索引擎聚合查询能力. 核心能力:中文搜索引擎集成、国际搜索引擎查询、结果聚合展示. 适用场景:技术资料检索、多源信息对比、快速知识查询. 差异化:免费版聚焦核心搜索功能,支持8个主流搜索引擎,适合个人快速检索. 适用关键词: 搜索引擎, 多源搜索, 信息检索, 聚合查询, search engine, multi-search, web search",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:multi-search-engine-tool-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent execute the browser workflow deterministically with explicit checkpoints?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final browser state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "browserWorkflow_run_{{rand}}"
      ]
    }
  }
}
