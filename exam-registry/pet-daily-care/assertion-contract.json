{
  "skillId": "pet-daily-care",
  "displayName": "宠物日常照护计划台",
  "description": "新手养宠最慌的是「到底该喂多少、要不要洗澡、什么时候驱虫」，网上说法互相矛盾。 输入：宠物种类与品种、月龄/年龄、体重、绝育与否、居住环境（楼房/有无院子）、已有照护习惯。输出：①每日节奏表（喂食次数与量级方向、饮水、遛/互动时长）②周期事项表（驱虫/疫苗/洗澡/剪甲的建议周期与注意事项）③环境布置清单（猫砂/窝/防抓/防误食）④异常信号清单（何时必须就医）⑤新手常见误区 ⑥月度记录表。永久免费，无需付费、无需授权（MIT-0）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:pet-daily-care"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
