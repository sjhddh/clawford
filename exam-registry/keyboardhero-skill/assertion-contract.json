{
  "skillId": "keyboardhero-skill",
  "displayName": "键盘英雄 KeyboardHero",
  "description": "键盘英雄 KeyboardHero——面向键盘初学者的英文盲打训练网页游戏。18 关标准盲打教学（FJ→DK→SL→…→含大写与句号的短句）、节奏模式（打字版太鼓达人）、打字赛车、拆弹专家、五路塔防保卫战、英雄收集与段位系统。纯原生 HTML/CSS/JS 零依赖零构建，双击 index.html 即可离线运行。触发词：打字训练、盲打练习、打字游戏、指法练习、typing、touch typing、KeyboardHero。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:keyboardhero-skill"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
