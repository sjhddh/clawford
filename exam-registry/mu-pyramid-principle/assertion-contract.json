{
  "skillId": "mu-pyramid-principle",
  "displayName": "金字塔原理逻辑教练",
  "description": "金字塔原理逻辑教练,支持快捷模式(贴文本自动诊断重组)和引导模式(对话构建金字塔)。触发词:金字塔原理、逻辑诊断、结构化思考、MECE、SCQA、结论先行、帮我理清思路、逻辑有问题、汇报结构。不适用:纯语法修改(用mu-humanizer-minesweeping)、PPT制作(用mu-ippt)、批判性思维提问(用mu-critical-thinking)。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:mu-pyramid-principle"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
