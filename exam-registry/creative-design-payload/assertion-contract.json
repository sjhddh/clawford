{
  "skillId": "creative-design-payload",
  "displayName": "Creative Design Payload",
  "description": "创意设计领域负载物，覆盖创意设计全流程的12个子域、280个任务。涵盖灵感采集、概念发散、视觉设计、交互设计、品牌设计、内容创作、用户研究、设计系统、客户提案、项目管理、知识沉淀、跨域协作等全流程。高创造性、高交互性、低规范性。触发词：创意设计、灵感采集、概念发散、视觉设计、交互设计、品牌设计、内容创作、用户研究...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:creative-design-payload"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
