{
  "skillId": "edu-lesson-plan",
  "displayName": "教案设计助手",
  "description": "备课最花时间的不是找资料，而是把「课标要求→教学目标→活动设计→课堂检测→作业分层」串成一条闭环，还要写清每步的时间分配。 输入：学段学科、课题名称、课时数、学生水平、教材版本（可选）。输出：①教学目标（知识/能力/素养三维）②重难点与突破策略 ③45 分钟时间轴（导入-新授-练习-小结）④课堂提问与预设答案 ⑤分层作业（基础/提升/拓展）⑥板书设计要点。永久免费，无需付费、无需授权（MIT-0）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:edu-lesson-plan"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
