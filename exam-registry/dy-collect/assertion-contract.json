{
  "skillId": "dy-collect",
  "displayName": "dy-collect",
  "description": "抖音视频互动数采集工具（社媒指数）。当用户需要采集/查询抖音视频的点赞数、评论数、收藏数、分享数、播放量等互动指标，提交一批抖音视频链接一键批量采集、导出采集结果 CSV（Excel 直开），或提到\"抖音采集/互动数采集/视频数据/播放量/社媒指数\"时使用本 skill。适合抖音投放结案、互动数统计、活动效果监测、爆款内容分析、达人视频分析等场景。支持 douyin.com/video/<id> 直链与 v.douyin.com 短链。收费服务（1 条视频 = 1 点数，注册送 10 点）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:dy-collect"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
