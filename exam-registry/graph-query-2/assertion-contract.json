{
  "skillId": "graph-query-2",
  "displayName": "图谱",
  "description": "把区块链数据查询请求路由至最合适的Graph Protocol服务，支持中文交互，提供实时数据和查询优化建议。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:graph-query-2"
  ],
  "version": "tier2-auto-v3",
