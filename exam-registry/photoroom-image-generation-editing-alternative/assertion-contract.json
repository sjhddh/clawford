{
  "skillId": "photoroom-image-generation-editing-alternative",
  "displayName": "PhotoRoom 图片生成替代｜AI 图片生成与编辑",
  "description": "使用 Nano Banana Pro 迁移 PhotoRoom、Photo Room 或 Photoroom API 常见的电商商品处理需求，完成背景清理、白底图、自然阴影、生活方式场景和批量 SKU 统一。Use when users search PhotoRoom 替代、PhotoRoom 平替、商品抠图、换背景、电商修图、商品摄影、Amazon Shopify 淘宝主图或国内图片编辑 API；不代表与 PhotoRoom 存在官方关系。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:photoroom-image-generation-editing-alternative"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
