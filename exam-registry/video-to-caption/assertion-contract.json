{
  "skillId": "video-to-caption",
  "displayName": "videotocaption",
  "description": "处理一切「视频→文字」需求：把本地视频文件或抖音、小红书等公网视频链接，转写成剔除冗余的干净文字稿，并按任意 Prompt 定制总结、小红书/抖音/公众号文案、金句提取、会议纪要、课程拆解、直播复盘、采访整理、中英互译等衍生内容。当用户提到视频转文字、字幕提取、语音转写、视频总结、提取文案、视频翻译或短视频二创时触发；不适用于直播流、需登录/会员/加密的链接、纯音乐视频或批量处理。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:video-to-caption"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
