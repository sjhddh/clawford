{
  "skillId": "b-collect",
  "displayName": "b-collect",
  "description": "B站视频互动数采集工具（社媒指数）。当用户需要采集/查询 B站视频的播放量、弹幕、评论数、收藏、投币、分享、点赞等互动指标，提交一批 B站视频链接一键批量采集、导出采集结果 CSV（Excel 直开），或提到\"B站采集/互动数采集/视频数据/播放量/社媒指数/稿子数据\"时使用本 skill。适合 B站投放结案、稿件数据盘点、活动效果监测、爆款内容分析、UP主稿件分析等场景。支持 bilibili.com/video/<BV号>、/video/av<数字> 直链与 b23.tv 短链。收费服务（1 条视频 = 1 点数，注册送 10 点）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:b-collect"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
