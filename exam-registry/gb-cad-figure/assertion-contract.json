{
  "skillId": "gb-cad-figure",
  "displayName": "gb-cad-figure",
  "description": "按中国国家标准(GB/T)生成正式工程图纸与CAD模板的可复用工作流：A3图框、标题栏、线型、国标尺寸标注、字体、比例、技术说明/图例、等轴测回转体(lathe/平滑轮廓)+引线式标注(LDIMS)+中心线+瓶底拱形，三格式交付(PDF+DXF+DWG)。开源品牌名 gb-cad-figure = GB国标 + CAD + 图形(figure)。 When to use: 当用户要求\"按国标出工程图纸\"、\"画图框/标题栏/尺寸标注\"、\"生成CAD模板(.dwt)\"、\"正式工程制图\"等涉及机械/建筑制图规范(GB/T)任务时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:gb-cad-figure"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
