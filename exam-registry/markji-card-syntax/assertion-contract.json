{
  "skillId": "markji-card-syntax",
  "displayName": "markji-card-syntax",
  "description": "使用中文生成、改写、检查和修正面向普通用户的 Markji 卡片语法（亦称“墨墨记忆卡”语法）内容。适用于用户要求制作可直接粘贴的 Markji 卡片或墨墨记忆卡内容、把笔记转换成卡片、添加挖空/选择题/文字样式/公式/媒体或卡片关联，以及排查卡片语法未生效、括号转义或嵌套错误的场景。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:markji-card-syntax"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
