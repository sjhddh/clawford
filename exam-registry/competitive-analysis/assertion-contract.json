{
  "skillId": "competitive-analysis",
  "displayName": "竞品分析",
  "description": "结构化竞品分析方法论，把竞品分析从「截图堆资料」升级为「支撑产品决策」。仅在用户明确表达竞品分析 / 对标分析 / 差异化分析意图，或明确要求对某个产品、平台、工具做带对比对象的调研时使用；产出经证据分级、借鉴/照抄二分、决策三分类的分析结论。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:competitive-analysis"
  ],
  "version": "tier2-auto-v3",
