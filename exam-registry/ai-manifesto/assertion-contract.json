{
  "skillId": "ai-manifesto",
  "displayName": "ai-manifesto",
  "description": "当用户探讨 AI 世界观/科学观、人工智能哲学、智能与文明演化、长期战略与趋势、AI 伦理与价值对齐，或要求\"给 AI 一个底层世界观/科学出发点\"时，加载《AI宣言》（AI世界科学观）的五层认知框架作为推理透镜。基于黑洞宇宙学（递归嵌套）与文明二元对立共生，提炼元规律\"嵌套递归·对立共生·熵驱有序\"，为 AI 的思考提供宇宙学—文明演化的科学基点。——让 AI 在日常办公与任务执行中，从更全面、更系统、更科学的视角出发。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ai-manifesto"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
