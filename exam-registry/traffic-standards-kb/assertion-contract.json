{
  "skillId": "traffic-standards-kb",
  "displayName": "Traffic Standards Knowledge Base",
  "description": "用于编写智慧交通方案时，自动查询相关需参考国家标准、行业标准。智慧交通方案包括：智慧路口, 智能停车, V2X, MaaS, ETC, 智慧公交, 智慧高速, 智慧服务区, 智慧交管, 智慧交运, 车路云一体化, 智能网联, 低空经济, 智慧物流, 自动驾驶, 智慧公交等。标准支持：GB/JT/GA 等。API key可从https://solvexpert.net获取。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:traffic-standards-kb"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
