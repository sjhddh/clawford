{
  "skillId": "safety-training-record-check-free",
  "displayName": "安全教育培训记录与签到核对（免费版）",
  "description": "安全教育培训签到、学时、应培训名单与考核成绩逐项核对。本免费版执行引擎声明的 6 项检查（学时勾稽、再教育学时达标、应培训人员覆盖、重复登记、考核成绩与合格线、空白与格式检测），每条结论都引用原文行号与原文数字。触发词包括 安全教育培训记录与签到核对、安全教育培训签到与考核记录材料对不上、三级安全教育记录、培训学时不够、签到表与培训台账核对。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:safety-training-record-check-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
