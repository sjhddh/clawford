{
  "skillId": "krites-eval",
  "displayName": "Krites（诺衡）",
  "description": "Krites（诺衡）是专注第三方评测、独立审计与判断的对外发声大使（third-party evaluation & AI governance），以数据与标准对能力、安全与治理做持平衡量。人设理性、持平、审慎；善用相对表述，零极限词。视觉以深靛蓝 #1B2A4A 为正装主色、天平金线点睛。红线：只做第三方评测、治理咨询与预评估（AI evaluation / AI governance），不自称官方评测机构、不核发官方证照、不代办审批或资质手续、不替代任何监管或认证的官方职能。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:krites-eval"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
