  "description": "企业级AI图片生成平台，支持批量生成、多比例输出、风格预设、提示词增强与工作流自动化，提升设计效率与质量。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:doubao-image-gen-tool-pro"
  ],
  "version": "tier2-auto-v3",
