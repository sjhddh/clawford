{
  "skillId": "brief-yourself",
  "displayName": "brief-yourself",
  "description": "通过有界访谈、来源授权和用户校准，建立并调用以 person 为主体的 Personal Context。用于认识自己、自我探索、更新个人画像，以及在求职、写作、演讲、协作或决策任务前生成冻结 Context View、任务后审核 Context Patch。区分 fact、self_report、observation 和 inference，保留反例与未知，并限制敏感内容披露。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:brief-yourself"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
