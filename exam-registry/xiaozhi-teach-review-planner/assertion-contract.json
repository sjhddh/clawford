{
  "skillId": "xiaozhi-teach-review-planner",
  "displayName": "复习规划师",
  "description": "把\"从头再讲一遍\"变成有间隔、有交叉、有取舍的复习排期。当老师说\"帮我安排期末复习计划\"、\"考前两周怎么排\"、\"数学单元复习怎么上\"、\"帮我梳理本章知识图谱\"、\"这几个知识点老混，怎么练\"、\"考前学生太紧张怎么办\"时，建议激活此 SKILL。工作流：知识图谱 → 重难点 → 阶段策略 → 间隔回看与交叉练习排期 → 复习活动 → 考前状态。本 SKILL 只出复习\"计划\"，不出复习\"作业\"：具体题目与分层任务卡转 xiaozhi-teach-assignment-designer，复习卷转 xiaozhi-teach-exam-designer。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:xiaozhi-teach-review-planner"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
