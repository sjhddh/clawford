{
  "skillId": "book-to-learn",
  "displayName": "book-to-learn",
  "description": "把任意一本书分解成日常学习任务，每日推送一张知识点卡片。 支持中英文书籍（PDF/DOCX/HTML/EPUB/TXT），拆解为知识点后每日推送。 英文书自动联网核对术语并实时翻译；中文书无翻译环节。 四种推送模板：PDF标准卡片、PDF大字闪卡、飞书交互卡片、飞书卡片+图片补充。 提示词与数据分离，可自由变体为单词学习、诗词海报、新闻讲解等任务。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:book-to-learn"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
