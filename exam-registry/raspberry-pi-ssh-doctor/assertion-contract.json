{
  "skillId": "raspberry-pi-ssh-doctor",
  "displayName": "Raspberry Pi SSH Doctor / 树莓派SSH诊断助手",
  "description": "Diagnose Raspberry Pi SSH resolution, timeout, refusal, host-key, and authentication failures using real OpenSSH or JishuBuddy evidence. / 依据OpenSSH或JishuBuddy实际输出，诊断树莓派SSH解析、超时、拒绝连接、主机密钥和认证问题。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:raspberry-pi-ssh-doctor"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
