{
  "skillId": "brand-dna-extractor",
  "displayName": "Brand Dna Extractor",
  "description": "Extract brand identity (colors, typography, visual style, imagery) from any website URL. Scrapes the site, analyzes CSS/images with K-means and VLM, and retu...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:brand-dna-extractor"
  ],
  "version": "tier2-auto-v3",
