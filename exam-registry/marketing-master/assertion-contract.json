{
  "skillId": "marketing-master",
  "displayName": "marketing-master",
  "description": "AI Agent 营销大师技能库：覆盖 SEO 审计与内容营销、高转化文案撰写、内容策略规划、着陆页构建、转化率优化（CRO）、付费广告投放与素材迭代六大能力，让独立开发者与小团队也能专业地推向市场。触发词：\"SEO\"、\"关键词研究\"、\"技术 SEO\"、\"文案\"、\"PAS\"、\"AIDA\"、\"StoryBrand\"、\"着陆页\"、\"转化率\"、\"内容策略\"、\"编辑日历\"、\"主题集群\"、\"内容衰减\"、\"CRO\"、\"A/B 测试\"、\"表单转化\"、\"付费广告\"、\"ROAS\"、\"广告素材\"、\"素材疲劳\"。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:marketing-master"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
