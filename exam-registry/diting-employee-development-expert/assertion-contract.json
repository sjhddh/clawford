{
  "skillId": "diting-employee-development-expert",
  "displayName": "Diting Employee Development Expert",
  "description": "谛听员工发展专家。人才盘点、干部评估、继任规划、职业发展路径。Use when 人才盘点、干部评估、继任规划、职业发展路径设计、高潜人才识别、九宫格人才盘点、胜任力模型、IDP个人发展计划、领导力梯队建设。不适用于薪酬结构、劳动法合规、培训课程设计等非员工发展类问题。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:diting-employee-development-expert"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
