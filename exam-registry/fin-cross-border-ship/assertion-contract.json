{
  "skillId": "fin-cross-border-ship",
  "displayName": "跨境物流方案台",
  "description": "跨境发货的选择表面是运费，实际是时效、清关要求、退件风险和税费的组合，报价单里往往看不全。 输入：起运地、目的地国家/地区、货物类型与重量体积、货值、时效要求、是否带电/液体/品牌。输出：①方案对比表（空运/海运/专线/快递：时效、计费重量、适用货值）②清关要求清单（所需单据与合规认证方向）③成本结构拆解（运费+关税+附加费+退件风险）④推荐方案与理由 ⑤打包与面单注意项。永久免费，无需付费、无需授权（MIT-0）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:fin-cross-border-ship"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
