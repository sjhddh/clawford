{
  "skillId": "ja-script-subtitle",
  "displayName": "ja-script-subtitle",
  "description": "日语有声作品（ASMR / 音声 / 同人音声）字幕流水线：把「日文台本 + 音频」做成 日文原文 / 纯中文 / 双语 SRT，可选烧录中文竖屏视频。 当用户提供日语台本(txt)配音频(mp3/wav)、或要求「配字幕 / 做中文字幕 / 生成 SRT / 烧录中文视频 / 把台本和音对上时间轴」时使用。 无台本、只有音频时也可用（退化为纯 ASR 转写 + 人工翻译），但精度低于有台本。 NOT for: 视频字幕的图形化编辑、非日语语种、音乐歌词校对。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ja-script-subtitle"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
