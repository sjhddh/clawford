{
  "skillId": "xiaoyaoclaw-kb-retriever",
  "displayName": "OpenClaw Knowledge Base Retriever",
  "description": "OpenClaw local knowledge-base retriever: hierarchical data_structure.md index navigation + progressive retrieval, zero external dependencies, Windows & macOS. Use when user asks to retrieve/answer from a knowledge base directory (knowledge base/retrieve/ RAG over local files). 面向本地知识库目录的检索和问答助手。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:xiaoyaoclaw-kb-retriever"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
