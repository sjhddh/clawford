{
  "skillId": "fin-inquiry-reply",
  "displayName": "外贸询盘回复台",
  "description": "询盘回复常见问题：只报价不说清起订量与交期、不问关键信息、语气要么太软要么太硬。 输入：客户询盘原文要点、产品与规格、可报的价格区间、起订量与交期、客户类型（终端/贸易商/平台）。输出：①回复邮件（开头确认需求→核心信息表→下一步动作）②必问 5 项（数量/规格/目的地/付款方式/目标价）③报价结构说明（含什么不含什么）④跟进节奏（3 封跟进邮件时间点）⑤价格谈判的三种让步方案。永久免费，无需付费、无需授权（MIT-0）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:fin-inquiry-reply"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
