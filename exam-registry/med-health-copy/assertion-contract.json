{
  "skillId": "med-health-copy",
  "displayName": "健康科普文案台",
  "description": "健康科普最容易踩两个坑：一是夸张恐吓（这样会致癌），二是越界给诊疗方案。合规又好看的写法需要结构。 输入：主题（如久坐/睡眠/控糖）、目标读者、平台（公众号/小红书/短视频口播）、篇幅。输出：①开头钩子（用生活场景，不用恐吓）②核心结论前置（3 条以内）③依据说明（讲机制，不编造数据）④可执行建议（每天能做到的小动作）⑤就医提示（什么情况该看医生）⑥合规自检清单。永久免费，无需付费、无需授权（MIT-0）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:med-health-copy"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
