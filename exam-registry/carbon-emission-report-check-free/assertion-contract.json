{
  "skillId": "carbon-emission-report-check-free",
  "displayName": "碳排放报告数据核对（免费版）",
  "description": "碳排放报告与活动数据逐格复算与勾稽（本免费版执行 6 项，另有 5 项完整档检查未执行且如实列出）。逐行复算 活动数据 × 排放因子 × 氧化率 = 排放量、分设施/分范围小计与合计对明细之和、范围二 万kWh/MWh/kWh/GJ 单位换算勾稽、同设施同年度同品种重复行、同品种排放因子不一致、必需字段空白与认不出格式检测，每条结论都引用原文行号与具体数字。缺必需列只报材料不足、绝不给结论。触发词包括 碳排放报告数据核对、排放报告复算、核查前自查、活动数据与排放量对不上。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:carbon-emission-report-check-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
