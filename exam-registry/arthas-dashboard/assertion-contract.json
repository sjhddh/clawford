{
  "skillId": "arthas-dashboard",
  "displayName": "arthas-dashboard",
  "description": "Arthas 监控可视化面板。直观展示 JVM 线程、内存、GC、方法调用等核心指标，并自动检测异常、分级诊断、提供可操作的解决方案。当用户说 \"dashboard\"、\"arthas\"、\"jvm 监控\"、\"线程分析\"、\"内存分析\"、\"方法耗时\"、\"CPU 高\"、\"死锁\"、\"GC 分析\"、\"火焰图\"、\"profiler\"、\"方法调用链\"、\"watch 方法\"、\"trace 方法\" 或任何 Arthas 诊断相关需求时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:arthas-dashboard"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
