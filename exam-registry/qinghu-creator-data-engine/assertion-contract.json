{
  "skillId": "qinghu-creator-data-engine",
  "displayName": "达人数据引擎 | 青虎AI",
  "description": "青虎AI 达人数据引擎：输入抖音、小红书、B 站的博主主页链接，自动抓取达人账号的基础数据与播放量核心指标并导出标准化 Excel，替代人工统计，用于竞品账号与合作达人的日常监控。当用户要批量统计达人账号数据、追踪博主每日涨粉与播放、监控竞品账号、管理合作达人数据、导出达人数据表时必须触发。关键词：青虎AI、达人数据、博主数据、账号监控、抖音、小红书、B站、粉丝、播放量、Excel、竞品账号、数据引擎。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qinghu-creator-data-engine"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
