{
  "skillId": "ruankao-spgm-essay-helper",
  "displayName": "软考高级·系统规划与管理师论文辅助",
  "description": "辅助备考软考高级资格「系统规划与管理师」的考生，根据用户输入的论文题目与本人真实项目背景，结合 IMA 备考资料库（历年真题/参考范文/考试大纲/教程）生成符合官方评分标准的论文框架与写作提示。论文背景仅来自考生本人真实项目，不引用任何第三方真实项目资料。当用户提及系统规划与管理师论文、系规论文、IT服务管理论文、软考系规论文大纲/框架/模板、软考高级论文（系统规划与管理师方向）等场景时触发。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ruankao-spgm-essay-helper"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
