{
  "skillId": "active-causal-experiment",
  "displayName": "active-causal-experiment",
  "description": "因果世界模型主动实验（Active Causal Experiment Design）。面对多个候选因果结构时，不被动观察，而是主动设计干预 do-operation，用期望信息增益/最优实验设计挑选最能区分候选结构的实验，Bayesian 更新后验，以最少实验辨识真实因果结构。当需要主动做实验以最快弄清变量间因果关系、设计 A/B 或干预实验、在多个竞争因果假设中高效辨识时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:active-causal-experiment"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
