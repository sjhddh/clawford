{
  "skillId": "results-vocabulary-lexis-advisor",
  "displayName": "results-vocabulary-lexis-advisor",
  "description": "用于诊断英文心理学论文 Results 部分的学术词汇与搭配质量，包括口语化表达识别、学术动词准确性、图表邀请语规范性、结果描述词恰当性、术语一致性和搭配自然度。本 Skill 是 Results 写作诊断总 Skill 的第 4 个子 Skill（成员 D），在 results-structure-diagnoser（A）、results-statistics-convention-checker（B）、results-tense-grammar-checker（C）之后执行。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:results-vocabulary-lexis-advisor"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
