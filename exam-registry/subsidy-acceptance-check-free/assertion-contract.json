{
  "skillId": "subsidy-acceptance-check-free",
  "displayName": "政府补助与专项验收核对（免费版）",
  "description": "本免费版只做台账金额与支出的逐行复算与勾稽，不做补助资格认定、不做政策适用性判定。逐行复算到账金额与补助金额的差额、专项支出合计与补助金额的配比、验收资料清单逐件点名缺件、同一补助年度内的重复申报、支出超预算与补助比例失衡、关键字段缺失与金额为负。每条结论都带原文行号。触发词包括 政府补助与专项验收核对、政府补助台账与验收资料对照表对不上。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:subsidy-acceptance-check-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
