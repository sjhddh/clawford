{
  "skillId": "payment-architect",
  "displayName": "Payment Architect (China Payment Systems) - Free Edition",
  "description": "国内第三方支付/聚合支付系统的架构专家（免费版）。This skill should be used when 用户讨论支付系统架构设计、域划分（网关/收银台/收单/交易/账户/清结算/渠道/风控/商户）、资金一致性方案（幂等、对账、事务边界、状态机），或需要设计/评审支付类系统的架构与核心链路。关键词：支付架构、收单、清结算、账户体系、对账、资金一致性、幂等、支付中台、聚合支付。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:payment-architect"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
