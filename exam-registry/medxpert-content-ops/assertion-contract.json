{
  "skillId": "medxpert-content-ops",
  "displayName": "MedXpert-CONT-001 · 官网与内容运营规范",
  "description": "MedXpert 官网与内容运营规范。触发场景：涉及 MedXpert 官网（medxpert.cn）、官网视觉/配色、官网内容更新、AI 友好隐藏原则、公众号话术、官网同步、乐享内容同步、对外宣传文案。加载本技能即可获得当前定稿的视觉规范、内容原则、同步流程与关键路径，避免重复摸索或误用旧规范。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:medxpert-content-ops"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
