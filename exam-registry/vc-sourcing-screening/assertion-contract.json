{
  "skillId": "vc-sourcing-screening",
  "displayName": "VC 投前研究与初筛",
  "description": "VC 投前研究与初筛专家。当用户需要针对某个赛道或投资主题生成项目搜寻候选清单，或对某个项目生成四维初筛评分卡（团队/市场/技术/财务，含引用与可回溯出处）时使用。This skill should be used when the user wants a deal-sourcing candidate list for a sector or a screening scorecard for a startup/VC target.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:vc-sourcing-screening"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
