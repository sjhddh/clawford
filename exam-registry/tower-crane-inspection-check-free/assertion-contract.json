{
  "skillId": "tower-crane-inspection-check-free",
  "displayName": "塔式起重机备案与检测核对（免费版）",
  "description": "塔机台账与检测报告逐项核对（检测有效期覆盖、使用登记证与司机信号工证件、检测结论、同一设备编号重复登记、合计行逐列复核、字段合法性），每条结论引用原文行号。触发词包括 塔式起重机备案与检测核对、塔机检测报告过期、使用登记证缺失、司机信号工证件过期、塔机台账对不上。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:tower-crane-inspection-check-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
