{
  "skillId": "wenwan-authentication",
  "displayName": "wenwan-authentication",
  "description": "文玩鉴定技能，支持绿松石、蜜蜡、南红、和田玉等文玩珠宝的真伪鉴别、品质评估与市场估价。 当用户需要鉴定文玩真伪、判断品质等级、评估市场价值、或需要购买建议时使用此技能。 触发场景包括：鉴定绿松石真假、判断是否原矿/注胶/染色、评估瓷度等级、给文玩估价、 识别文玩优化处理手段、或其他文玩珠宝（蜜蜡、南红、和田玉、翡翠等）的鉴定需求。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:wenwan-authentication"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
