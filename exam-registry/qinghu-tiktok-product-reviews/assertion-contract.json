  "description": "青虎AI TikTok-商品评论：按 product_id 获取 TikTok Shop 已采集的商品评论列表。当用户说「看看这个 TikTok 商品的评论」「买家怎么评价这款」「商品差评」或提出同类需求时必须触发。关键词：青虎AI、qhkit、青虎数据、TikTok、TikTok Shop、抖音国际版、商品评论、买家评价、差评、商品评论列表。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qinghu-tiktok-product-reviews"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
