{
  "skillId": "huifu-merchant-onboarding",
  "displayName": "汇付商户进件集成",
  "description": "商户进件skill：汇付支付/斗拱支付（Huifu Payment）商户进件、用户进件、开户、KYC 与商户管理（Merchant Onboarding）。用于企业、个体工商户、小微商户或无执照个人的入驻、入网和实名认证，以及营业执照、法人、结算卡、股东、联系人、门店等资料和图片上传，以及微信、支付宝、银联、银行卡、快捷、网银、分账、代扣、余额、预授权、补贴 、合单等业务的开通、补开、业务开通修改或配置修改，以及商户资料、基本信息修改、商户详情、结算信息、费率查询、多费率配置及查询，申请状态、审核、实名、绑卡、电子协议和商户状态变更等开发集成。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:huifu-merchant-onboarding"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
