{
  "skillId": "wechat-ecosystem-data-hub",
  "displayName": "微信生态数据台",
  "description": "曼格云(api.we-media.cn)多接口数据助手。按需求选择随包目录中的公众号、视频号、搜索、热搜、小程序、视频理解、转写或余额接口，采集并导出。适合组合查询；执行前按实时价格预估，不承诺未列入目录的接口已支持。 适用场景：用户要用曼格云查询任何微信生态数据（公众号、视频号、搜索、热搜、小程序、AI分析），或需求不明确需要自动选接口时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:wechat-ecosystem-data-hub"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
