{
  "skillId": "patentmax-roadmap",
  "displayName": "技术路线分析 · PatentMax",
  "description": "技术路线分析与专利布局建议。当用户问下一步该往哪个方向研发、专利该怎么布、哪条技术路线更值得走、怎么绕开竞争对手的专利、申请预算该怎么分配，或要一份可交付的技术路线与布局方案时使用。Use when the user asks which technology route to take, how to plan a patent portfolio, or how to design around competitors' patents. Requires a PatentMax API key.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:patentmax-roadmap"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
