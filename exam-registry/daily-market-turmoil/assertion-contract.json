{
  "skillId": "daily-market-turmoil",
  "displayName": "全球股市资讯",
  "description": "每日收集全球股市资讯（A股/港股/美股/欧股/亚太），覆盖各行业板块，国内国外各至少5条共至少10条，生成标题为「每日动荡+日期」的Markdown报告。当用户要求生成每日股市资讯报告、全球行情速览、市场变动分析，或引用「每日动荡」时使用。报告重点突出「影响当日市场变动的关键消息」而非简单罗列行情，并包含「昨日总结+今日预期」两个核心分析板块。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:daily-market-turmoil"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
