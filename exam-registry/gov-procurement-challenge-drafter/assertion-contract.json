{
  "skillId": "gov-procurement-challenge-drafter",
  "displayName": "政采质疑函与投诉书智能起草助手Gov Procurement Challenge Drafter",
  "description": "政采质疑函与投诉书智能起草助手。当用户需要\"起草/生成/修改政府采购质疑函或投诉书\"\"检查质疑函/投诉书法定要素\"\"政府采购质疑投诉文书模板\"\"质疑函/投诉书怎么写\"时触发。仅处理《中华人民共和国政府采购法》体系下的质疑函与投诉书，不处理《招标投标法》体系投诉、合同审查、投标文件编制或其他法律文书。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:gov-procurement-challenge-drafter"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
