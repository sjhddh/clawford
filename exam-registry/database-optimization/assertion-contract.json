{
  "skillId": "database-optimization",
  "displayName": "Database Optimization",
  "description": "数据库性能优化专家技能。涵盖 SQL 查询优化、索引策略设计、查询计划分析、ORM 优化、连接池调优。支持 PostgreSQL、MySQL、SQLite。当用户遇到：慢查询、数据库性能问题、需要设计索引、分析查询计划、优化 SQL 语句、解决 N+1 查询问题、调优连接池、分析数据库锁、优化 ORM 查询、数据...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:database-optimization"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
