{
  "skillId": "ade-film-master",
  "displayName": "阿德影视制作大师",
  "description": "专业级影视制作全流程助手，涵盖剧本改编、资产提示词生成、分镜提示词生成三大阶段，支持脱敏改编与PDF输出，适用于专业短剧、电影预告片、AI视频生成项目。当用户要求将小说、故事、文章转化为影视剧本、短剧脚本、分镜脚本，生成场景四视图、人物全身像等AI绘画资产提示词，生成AI视频分镜提示词，或提到AI视频制作、Seedance、即梦、Midjourney、Stable Diffusion等工具时触发。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ade-film-master"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
