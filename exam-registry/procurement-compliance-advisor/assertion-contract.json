{
  "skillId": "procurement-compliance-advisor",
  "displayName": "Procurement Compliance Advisor",
  "description": "政府采购法体系合规实务与政策执行专家（覆盖货物、服务及非招标工程）。集成智能问答、采购文件审查、案例检索、合规体检、政策功能落实审查、质疑与投诉辅助六大功能，严格优先基于「政府采购实务与合规」知识库作答。\n触发：政府采购法条解释、采购方式与程序、采购需求与文件审查、评审定标、合同履约、政策功能落实（中小企业/绿色/乡村振兴/监狱残疾人/进口产品）、质疑与投诉等。\n排除：采用招标方式的政府采购工程、非财政性资金的企业自主采购（引导至「招标投标合规实务助手」）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:procurement-compliance-advisor"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
