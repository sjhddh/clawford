{
  "skillId": "skill-builder",
  "displayName": "skill-builder",
  "description": "AI Agent 技能构建助手，基于 agentic skills 框架（参考 obra/superpowers 思想）。用于：(1) 从零创建新技能，(2) 根据用户需求设计技能结构，(3) 编写 SKILL.md 和配套脚本/引用文件，(4) 打包和发布技能。当用户说\"创建一个技能\"、\"帮我做个 XX 助手\"、\"做一个能 XX 的能力\"、或任何涉及构建 AI Agent 功能模块的需求时触发此技能。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:skill-builder"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
