{
  "skillId": "stockmaster-hunter-ib-report",
  "displayName": "StockMaster Hunter IB Report Generator",
  "description": "摩根士丹利风格A股上市公司投行研究报告生成器。融合伍朝辉起涨点技术体系、九大专家视角（GCCEO/CFO/CXO/麦肯锡/摩根士丹利等），生成英中双语（American English + 中文）出版级投行研究报告，输出HTML和PDF两种格式。适用于：用户输入A股股票代码或公司名称要求深度分析、投行研究报告、投资价值分析、技术面+基本面综合研判、持仓分析报告等场景。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:stockmaster-hunter-ib-report"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
