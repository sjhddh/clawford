{
  "skillId": "autoshop-parts-labor-check-free",
  "displayName": "汽修配件与工时费结算核对（免费版）",
  "description": "维修工单配件与工时费明细表逐项核对。配件小计复算（配件小计 = 数量 × 配件单价）、工时费复算（工时费 = 工时 × 工时单价）、工单总额勾稽（工单总额 = 配件小计 + 工时费 + 辅料费 − 折扣）、同一工单同一配件重复行、配件数量或工时为负、关键字段空缺或占位符。每条结论都引用原文行号，材料不足时不给结论。触发词包括 汽修配件与工时费结算核对、维修工单配件与工时费明细表对不上、配件小计算错、工时费不对、工单总额对不上。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:autoshop-parts-labor-check-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
