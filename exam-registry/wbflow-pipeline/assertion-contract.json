{
  "skillId": "wbflow-pipeline",
  "displayName": "WBFlow·多Agent视频流水线总控",
  "description": "流水线总控——按顺序串联 story→script→storyboard→(定妆char)→prompt→image→video→assemble 八个环节，只调度与校验，不产出任何内容。用于一句话驱动整套 AI 漫剧/短视频生产。（WBFlow 由 9 个 skill 组成：本总控 + story/script/storyboard/prompt/char/image/video/assemble 八环，须全套配套安装，单独安装无法运行。）",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:wbflow-pipeline"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
