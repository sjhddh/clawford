{
  "skillId": "skill-quality-training-planner",
  "displayName": "Quality Training Planner",
  "description": "生成为主+轻交互定制的质量培训策划工具，为质量月培训、专项技能提升、新员工质量意识培训快速产出可落地的培训方案。Agent 直接生成通用质量培训内容（培训目标分层、课程大纲、教学方法、考核方式、讲师要求、资源清单、柯氏四级评估），仅就培训对象/主题/时长/企业专属案例做交互定制；企业内部案例/标准编号标「待企业补...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:skill-quality-training-planner"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
