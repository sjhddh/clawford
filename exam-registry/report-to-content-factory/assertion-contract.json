{
  "skillId": "report-to-content-factory",
  "displayName": "Report-to-Content Factory / 研报内容创作工厂",
  "description": "Turn research into original WeChat articles, Xiaohongshu posts, and video scripts with citations and visual suggestions. No automatic publishing. / 将研报转化为原创公众号文章、小红书文案和视频脚本，附引用与配图建议，不自动发布。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:report-to-content-factory"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
