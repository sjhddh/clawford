{
  "skillId": "pdd-update-price",
  "displayName": "PDD Price Update",
  "description": "Changes Pinduoduo SKU prices with a dry-run-by-default workflow, change-ratio guardrails, audit log and one-command revert. Use only when the user explicitly asks to change prices on their PDD shop. 拼多多改价：默认只出计划不执行，显式确认才改价，带涨跌幅护栏、本机审计日志与一键回滚；仅在用户明确要求调价时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:pdd-update-price"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
