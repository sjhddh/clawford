{
  "skillId": "content-creator",
  "displayName": "content-creator",
  "description": "内容创作者技能库：覆盖短视频脚本、视频编辑、播客制作、YouTube 运营与新闻简报（邮件通讯）的全流程。 提供内容策略与平台适配、选题与制作工作流的方法论，并用子技能承载视频/音频/社媒/简报的具体落地写法。 触发词：\"内容创作\"、\"短视频\"、\"视频编辑\"、\"播客\"、\"YouTube\"、\"简报\"、\"newsletter\"、 \"邮件通讯\"、\"脚本\"、\"选题\"、\"剪辑\"、\"色彩分级\"、\"缩略图\"、\"发布排期\"、\"内容策略\"、\"多平台分发\"。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:content-creator"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the generated content align with the requested scope and structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate output quality against explicit criteria?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "contentGenerator_run_{{rand}}"
      ]
    }
  }
}
