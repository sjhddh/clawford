{
  "skillId": "hekouwang-env-doctor-skill",
  "displayName": "开发环境体检器（env-doctor）",
  "description": "开发环境与磁盘体检：默认只读扫描（不读用户文档内容、不联网、不上报），按数据/缓存/残留三分法给出判定与官方清理建议。clean 子命令只跑各工具官方的缓存与旧版本清理命令（npm、yarn、pnpm、brew、pip、uv），逐项确认后执行；不删除版本管理器目录、不删模型权重与容器数据；被判为残留的版本管理器只在报告里给手动卸载步骤。附 scripts/run-all-doctors.sh：会调用 claude-md-doctor 与 skill-doctor，额外报告配置与技能分数，属附加能力。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:hekouwang-env-doctor-skill"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
