{
  "skillId": "video-subtitle-summary",
  "displayName": "边看边记-视频要点自动归纳",
  "description": "从视频或学习平台中提取已暴露的字幕/transcript，再归纳为带时间戳的 Markdown 知识点报告。当用户要求打开、分析、归纳视频链接、字幕文件或浏览器可访问的课程页面，或基于视频内容生成学习笔记时使用。仅处理字幕可达的内容；不做音频转写、音频提取、实时播放捕获，也不绕过 DRM/付费墙/登录限制。默认所...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:video-subtitle-summary"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
