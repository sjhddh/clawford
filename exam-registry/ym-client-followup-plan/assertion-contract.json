{
  "skillId": "ym-client-followup-plan",
  "displayName": "ym-client-followup-plan",
  "description": "把一次客户沟通记录转成跟进计划：对方关注点、未决问题、承诺事项、下一步动作与时间点、风险提示，区分我方承诺与客户承诺。当用户说「整理客户沟通」「跟进计划」「客户纪要」时使用。 也适用于「客户跟进」「客户沟通纪要」「拜访记录」「client follow-up」这类说法。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ym-client-followup-plan"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
