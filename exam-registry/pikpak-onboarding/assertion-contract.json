{
  "skillId": "pikpak-onboarding",
  "displayName": "pikpak-onboarding",
  "description": "Set up PikPak with the CLI: install, informed referral choice, browser signup, and a first verified cloud download. 引导 PikPak 安装、注册与首个磁力/链接转存；不代注册、不代登录。 Triggers: PikPak 使い方, PikPak 登録, PikPak 始め方, PikPak 사용법, PikPak 가입, PikPak 怎么用, PikPak 註冊, PikPak 注册, PikPak 邀请码",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:pikpak-onboarding"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent execute the browser workflow deterministically with explicit checkpoints?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final browser state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "browserWorkflow_run_{{rand}}"
      ]
    }
  }
}
