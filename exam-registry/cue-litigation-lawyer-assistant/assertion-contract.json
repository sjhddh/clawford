{
  "skillId": "cue-litigation-lawyer-assistant",
  "displayName": "诉讼律师全能助手（专业版·不限国内）",
  "description": "专为从事民商事及刑事诉讼的执业律师、法务打造的 AI 案头助手。将繁琐的“查、核、算、写”工作交由 AI 处理——支持秒级调用 MCP 检索现行法规原文；更支持深度研判：合同审查、疑难案件类案检索、复杂赔偿金/诉讼费自动理算、诉讼文书高质量起草与仿写、深度文书审校（自动核验法条效力与案号真伪）。直连北大法宝等权威法律数据库，产出结论均附原始链接，助力法律人大幅节省案头时间。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:cue-litigation-lawyer-assistant"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
