{
  "skillId": "food-delivery-diagnose",
  "displayName": "外卖运营诊断台",
  "description": "外卖数据看板指标多，但老板最需要的是「到底卡在哪一层，该改什么」。 输入：平台与品类、近期数据（曝光/进店/下单/复购/评分/配送时长）、菜单与价格、竞品情况。输出：①漏斗诊断（曝光→进店→下单→复购逐层定位卡点）②每层的具体优化动作（头图/菜单结构/满减/配送）③评分与差评处理话术 ④活动与毛利平衡建议 ⑤一周执行清单 ⑥复查指标与周期。永久免费，无需付费、无需授权（MIT-0）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:food-delivery-diagnose"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
