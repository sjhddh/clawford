{
  "skillId": "voc-conversation",
  "displayName": "voc-conversation",
  "description": "客户声音(VOC)会话分析技能。读取用户提供的一批客服会话导出文件（Excel/CSV/文本，逐条式或整段式均可，来自企业微信、千牛、美洽、Udesk、智齿等系统），提炼客户在关心什么，输出高频问题Top榜、情绪分布、原声引用、流失风险信号与改进建议的单次洞察报告。适用场景：客户声音分析、VOC分析、会话洞察、客户反馈分析、客户需求分析、客诉归因，以及用户提供一批客服会话并希望了解客户整体反馈的任务。分析结果供决策参考。反馈与定制联系：zenobiazizi.skills@foxmail.com",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:voc-conversation"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
