{
  "skillId": "reading-notes",
  "displayName": "读书笔记结构化整理",
  "description": "上传书籍文本 / 摘抄段落，梳理书籍核心框架、人物关系、核心论点、金句摘抄，分章节生成思维导图式结构化笔记。粘贴书籍内容或上传书籍截图，输出分层结构化笔记：全书整体框架、分章节核心论点、关键案例、可直接摘抄金句，逻辑清晰，适合读书报告、课堂作业使用。Use when the user asks for 读书笔记、读书报告、章节梳理、金句摘抄、人物关系、故事脉络、考点整理，或上传书籍文本/摘抄/截图要求结构化整理。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:reading-notes"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
