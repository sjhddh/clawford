{
  "skillId": "qa-team-skills",
  "displayName": "QA团队技能集",
  "description": "当用户表达模糊 QA 需求或希望一个入口自动分发到 PRD评审/用例/专项测试/缺陷/报告/团队/探索性测试之一时使用。 作为统一编排入口，根据意图自动路由到对应子技能：需求评审(PRD)、测试用例设计、AI/Agent 专项测试、缺陷根因分析、测试报告（日报/周报/阶段/季度）、团队管理（进度/准出/质量评估）、 探索性测试。支持自然语言触发，如\"评审这份 PRD\"\"设计登录功能的测试用例\"\"对支付接口做全量回归并出缺陷报告\"。 NOT for：普通闲聊、写与测试无关的一般文档、或明显不属于 QA 范畴的任务。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qa-team-skills"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
