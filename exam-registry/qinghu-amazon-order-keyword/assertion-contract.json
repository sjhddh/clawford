  "description": "青虎AI 亚马逊-ASIN出单词反查：反查一个或多个 ASIN 在指定周期内真正带来曝光与转化的关键词，判断转化结构在改善还是恶化。当用户说「这个 ASIN 的出单词」「哪些词真正出单」「广告该否哪些词、加哪些词」或提出同类需求时必须触发。关键词：青虎AI、qhkit、青虎数据、亚马逊、Amazon、出单词、转化词、否词、扩词、广告优化、出单词反查。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qinghu-amazon-order-keyword"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
