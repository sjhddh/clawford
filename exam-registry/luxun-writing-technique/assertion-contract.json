{
  "skillId": "luxun-writing-technique",
  "displayName": "鲁迅先生写作手法",
  "description": "鲁迅先生写作手法 v2.0 — 不是写作工具箱，是解剖的立场。当用户需要：(1) 把温情化、鸡汤化的初稿改写成冷峻解剖式文本；(2) 揭示文本中'看客'与'吃人'结构；(3) 用鲁迅式怀疑精神重写文章结尾；(4) 写有力量感的杂文/评论/悼词/演讲稿；(5) 拒绝廉价希望、拒绝煽情、拒绝心灵鸡汤。触发词：鲁迅风格、冷峻解剖、不留情、不要鸡汤、揭穿、看客、怀疑、力量感、刻薄但有温度。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:luxun-writing-technique"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
