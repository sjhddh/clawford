{
  "skillId": "maxhub-bilibili-pro",
  "displayName": "B 站数据助手",
  "description": "Bilibili（B 站）公开数据查询与内容分析 skill，通过 MaxHub API 查询视频详情、播放信息、字幕、分 P、BV/AV 转换、UP 主资料、投稿、动态、搜索、热搜、评论弹幕、直播间与公开收藏夹等 40 个端点。适合内容选题、UP 主画像、番剧/字幕研究、互动分析和直播数据看板。默认以只读公开数据为主。所有请求发送到 https://www.aconfig.cn。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:maxhub-bilibili-pro"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
