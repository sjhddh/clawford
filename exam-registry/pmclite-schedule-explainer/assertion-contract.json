{
  "skillId": "pmclite-schedule-explainer",
  "displayName": "排产结果解释",
  "description": "解读已有排程：这张单为什么落在这一天、这条线，工时按哪种模型算出来，被谁挤占而顺延，降级标记又是什么意思。 用户说“这张单为什么排在 11 月 20 日”“工时怎么算出来的”“怎么突然变成 106 天”“为什么不在原来那条线”“降级是什么意思”“帮我把这个日期讲清楚”时使用。 不触发：需要重新算一遍或写回系统（用 pmclite-scheduler）、查缺料、测算急单影响、做周汇总。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:pmclite-schedule-explainer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
