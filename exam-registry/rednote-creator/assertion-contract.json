{
  "skillId": "rednote-creator",
  "displayName": "rednote-creator",
  "description": "小红书内容创作全流程 skill。覆盖选题策划、文案写作、标题生成、多图封面生成、发布策略和一键发布。 支持6大热门赛道：美妆护肤、穿搭时尚、减脂健身、美食探店、旅行攻略、家居收纳。 触发词：发小红书、小红书笔记、写小红书、rednote、小红书文案、 小红书选题、小红书封面、发笔记、发种草、发攻略。 NOT for: 账号数据分析、竞品监控、自动刷量、批量关注点赞、生成虚假效果对比图。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:rednote-creator"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
