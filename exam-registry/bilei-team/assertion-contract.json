{
  "skillId": "bilei-team",
  "displayName": "避雷选品团.skill",
  "description": "避雷.skill 的多Agent重型版：四角色协作（反投毒取证官/定量对比官/主裁决官/价格情报官），角色隔离封死确认偏误。只认公关不了的数据——行政处罚、抽检不合格、召回公告，反软广反GEO投毒，逐款做信源利益审计（谁付的钱、能取事实层还是评价层），四问对价定量裁决（省多少现金、担什么风险、临界故障率p*、溢价ROI），预算S/A/B/C分级，结论先行给唯一推荐，适合>¥2000大件与安全关键品类。触发词：避雷选品团、选品、买什么、求推荐、对比、值不值得买、避坑、扫雷、性价比、质价比、溢价、历史低价、好价、预算XX买什么。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:bilei-team"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
