{
  "skillId": "guaikei-video-subtitle-transcript",
  "displayName": "guaikei视频字幕提取转文字",
  "description": "将已完成的点播视频转写为文字与结构化文案。当用户提供本地视频文件或抖音、小红书等公网视频链接，要求视频转文字、视频转稿、字幕提取、视频总结、会议纪要、课程拆解、二创改写时使用。不支持实时直播流、需登录的加密视频与纯音乐无人声视频；转写后可按自定义 Prompt 生成总结、金句、分镜头、翻译等",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:guaikei-video-subtitle-transcript"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
