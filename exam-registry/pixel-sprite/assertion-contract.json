{
  "skillId": "pixel-sprite",
  "displayName": "像素精灵",
  "description": "将参考图或文字描述的主体转换为低分辨率像素插画 / 像素图标（Low Resolution Pixel Sprite）。当用户上传一张图并说「做成像素风 / 像素画 / pixel art / 8-bit / 16-bit / sprite / 游戏图标 / 像素头像」，或想把 logo、吉祥物、产品、宠物、人物变成复古游戏像素素材时使用。严格保留原主体设计，只转换表现形式；输出 32×32 规格、硬边像素、有限色板、纯白背景的单主体居中图。不适用于像素风海报排版、点阵印刷海报或需要文字 / 场景的整图设计。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:pixel-sprite"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
