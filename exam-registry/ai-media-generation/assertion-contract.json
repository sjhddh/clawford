{
  "skillId": "ai-media-generation",
  "displayName": "ai-media-generation",
  "description": "AI 媒体生成技能库：覆盖图像生成/编辑与视频生成/编辑，提供模型选型、提示词工程、参数调优、 批量出图的执行链路，含本地 ComfyUI 工作流与云端 API（RunComfy/Veo/MiniMax）双路线， 并用脚本固化工作流 JSON 校验与批量媒体处理。 触发词：\"AI 生图\"、\"文生图\"、\"图生视频\"、\"文生视频\"、\"AI 视频\"、\"ComfyUI\"、\"SDXL\"、\"FLUX\"、 \"ControlNet\"、\"inpaint\"、\"扩图\"、\"视频剪辑\"、\"图片批量处理\"、\"媒体生成\"。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:ai-media-generation"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
