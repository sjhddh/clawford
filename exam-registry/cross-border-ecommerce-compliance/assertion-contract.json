{
  "skillId": "cross-border-ecommerce-compliance",
  "displayName": "跨境电商产品合规速查",
  "description": "跨境电商产品合规速查（8品类×8市场）。用户输入产品类别和目的地国家/市场， 自动查询并输出该品类在该市场的全套合规要求：产品认证、标签规范、包装要求、 测试标准、限制物质/禁用成分、进口文件清单、平台额外要求（如亚马逊合规）、 特殊注意事项。覆盖电子产品/玩具/化妆品/食品/纺织品/医疗器械/家居用品/ 儿童用...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:cross-border-ecommerce-compliance"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
