{
  "skillId": "wiki-framework-builder",
  "displayName": "Wiki Framework Builder",
  "description": "在 research-task-scope-definition 之后使用，或当用户要求搭建咨询风格报告框架、行业报告大纲、可行性研究结构、市场进入框架、排名/背书报告框架、政府研究报告大纲、政策/咨询报告结构时使用。本技能消费 task-scope JSON 交接文件，选择并重组工程化研究维度，产出固定格式的对...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:wiki-framework-builder"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
