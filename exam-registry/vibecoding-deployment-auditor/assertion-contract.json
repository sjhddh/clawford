{
  "skillId": "vibecoding-deployment-auditor",
  "displayName": "AI网站一键发布",
  "description": "面向国内 VibeCoding 与零基础用户的一键静态网站发布：将 H5 游戏、个人作品集、企业官网和活动页等 HTML/CSS/JavaScript、Vite/React/Vue 静态构建发布为公开 HTTPS 链接；无需 GitHub、服务器、域名或 Sites。One-click static site p...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:vibecoding-deployment-auditor"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
