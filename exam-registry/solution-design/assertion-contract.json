{
  "skillId": "solution-design",
  "displayName": "Solution-Design",
  "description": "把目标与约束转成可执行、可验收的行动方案。覆盖产品方案、教学方案、测评方案、培训方案、营销方案、增长方案、投放方案、照护方案、训练方案、营养方案、身心调适方案、诉讼方案、应急预案、预算与资源方案、客户与渠道运营方案、组织与人力方案 共 16 域 72 项任务。触发词：方案、计划、策划、规划、流程、SOP、教案、课程、训练、护理、应诉、预算、应急预案、资源分配、meta-skill-system。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:solution-design"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
