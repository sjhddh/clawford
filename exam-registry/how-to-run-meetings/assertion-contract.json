  "description": "怎样开会——从《怎样开会》（任仲然著，党建读物出版社）提炼的会议方法论技能库。当用户要筹备、主持、讲话、写纪要、抓落实等任何会议相关任务（工作部署会、决策会、座谈会、现场会、视频会、学习会），或问及会议规则、议事规则、讲话稿写法、会议精神落实时使用。Use when planning, chairing, speaking at, or following up on any meeting, or referencing the book's frameworks.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:how-to-run-meetings"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
