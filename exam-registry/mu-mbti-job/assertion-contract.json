{
  "skillId": "mu-mbti-job",
  "displayName": "MBTI人格与职业测评",
  "description": "个人职业发展场景的 MBTI 人格测评。三档题库深度：70题快速版/93题标准版/144题专业版，中英双语，输出 PDF 中英双语人格与职业报告：四维度倾向与清晰度、核心特征、优势盲区、职业岗位推荐、人际匹配。纯本地运行零依赖。触发词：MBTI、MBTI测试、性格测试、人格类型、16型人格、职业性格、职业测评、mbti test。不适用：DISC、盖洛普、大五人格等其他人格测评，以及给 AI Agent 测人格的场景",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:mu-mbti-job"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent transform artifacts correctly and preserve important structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify transformed outputs before completion?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "fileTransformer_run_{{rand}}"
      ]
    }
  }
}
