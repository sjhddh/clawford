{
  "skillId": "document-governance",
  "displayName": "document-governance",
  "description": "工程文档治理元技能。当任务涉及 AI 编程项目的文档体系设计、文档类型选择（PRD/DESIGN/ADR/PROGRESS/RETRO/TECH/PERSONA/RUNBOOK/ROADMAP）、三层记录模型（过程层/项目层/知识层）、现状文档与规范文档的强制区分，或需要路由到文档编写/评审/治理子技能时使用。触发词：文档治理、文档体系、文档结构、三层模型、arc42、C4、架构决策记录、需求文档、进度、复盘、知识笔记、文档评审、交叉验证。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:document-governance"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
