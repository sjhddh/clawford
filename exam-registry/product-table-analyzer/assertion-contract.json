{
  "skillId": "product-table-analyzer",
  "displayName": "商品表市场洞察分析",
  "description": "商品表市场洞察分析。上传一张商品列表表格（CSV/Excel），自动从类目分布、标题词频、价格带、卖家品牌格局、卖点提炼、竞争度评估6大维度进行选品分析，生成交互式HTML可视化报告。适合运营导出的商品数据快速生成选品洞察。触发词：商品表分析, 选品分析, 市场洞察, 商品表格分析, 批量商品分析, 商品数据报告...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:product-table-analyzer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
