{
  "skillId": "wechat-attachment-organizer",
  "displayName": "微信附件整理",
  "description": "整理 PC 端微信（Windows/macOS/Linux，3.x 与 4.x 自动探测）聊天中的附件（文档/图片/视频），按类型或客户分类、去重后复制到指定目录，并可导入资料库全文检索。合规版——仅读取本地文件，绝不解密或访问聊天数据库。当用户说\"整理微信附件/微信文件分类/把微信收到的文件归类/微信重复文件去重\"时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:wechat-attachment-organizer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
