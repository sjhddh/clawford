{
  "skillId": "seo-assistant",
  "displayName": "云指建站SEO优化助手",
  "description": "网站 SEO 体检与优化流水线 skill。当用户需要对一个网站（通用站点）做 SEO 健康体检、逐维度分析（关键词/Title/Description/Heading/URL/内链/Schema/可索引性/页面）、生成优化方案、执行低风险修改、对高风险修改请求确认、复检并输出 SEO Score 时使用。内置零依赖 Python 抓取分析脚本，可输出结构化报告与按风险分级的优化建议。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:seo-assistant"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
