{
  "skillId": "qinghu-tiktok-creator-detail",
  "displayName": "TikTok-达人详情查询 | 青虎AI",
  "description": "青虎AI TikTok-达人详情查询：按 user_id 或 unique_id（@用户名）批量查询达人详情（单次最多 10 个）。当用户说「查一下这个 TikTok 达人的数据」「@xxx 的粉丝和带货情况」「达人详情」或提出同类需求时必须触发。关键词：青虎AI、qhkit、青虎数据、TikTok、TikTok Shop、抖音国际版、达人详情、unique_id、粉丝数、带货数据、批量获取达人详情。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:qinghu-tiktok-creator-detail"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
