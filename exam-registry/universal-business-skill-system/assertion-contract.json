{
  "skillId": "universal-business-skill-system",
  "displayName": "Universal Business Skill System",
  "description": "通用行业业务技能体系。基于\"任务为中心，AI Pipeline驱动\"思想，适用于任何行业的结构化业务能力框架。覆盖情报采集、内容生产、活动运营、数据分析、知识管理、合规风控、客户运营、流程协同、资质认证、供应链运营十大业务流。内置12个行业校准模板（消费与零售、平台与数字、专业与知识、制造与工业、强监管、资产运营...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:universal-business-skill-system"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
