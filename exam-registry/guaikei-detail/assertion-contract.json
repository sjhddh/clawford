  "description": "xhs笔记详情查询｜输入小红书笔记链接，获取笔记完整信息：标题、正文、图片/视频、标签、发布时间、互动数据（点赞/收藏/评论数）、作者信息等，返回结构化JSON，适合对单篇爆款笔记做深度拆解与内容分析",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:guaikei-detail"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
