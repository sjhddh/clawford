{
  "skillId": "trial-balance-check-free",
  "displayName": "试算平衡与期末结转核对（免费版）",
  "description": "公司每月结账、每年审计前必做的科目余额表核对（免费版）。逐行复算资产负债类「期末余额 = 期初余额 + 本期借方发生额 − 本期贷方发生额」、检查损益类期末是否结转为零、期初与本期与期末三处借贷合计是否相等、明细账与总账勾稽、科目层级小计、重复科目、空缺与非数字。每条结论都带原文行号，可由第三方用同一份输入复算，不需要付款，也不需要注册。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:trial-balance-check-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
