{
  "skillId": "video-script-pacing-reviewer",
  "displayName": "Video Script Pacing Reviewer",
  "description": "审查视频脚本和 PPT 稿件的节奏、时长分配、画面旁白配合、信息密度、钩子过渡和平台适配。输出结构化审稿报告 + 逐段评分 + 改写建议。Use when: review video script, audit presentation pacing, check slide deck rhythm, scrip...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:video-script-pacing-reviewer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
