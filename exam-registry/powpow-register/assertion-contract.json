{
  "skillId": "powpow-register",
  "displayName": "PowPop 泡泡注册助手",
  "description": "陪用户在自己浏览器里完成 PowPop（泡泡）账号注册、邮箱验证与会员订阅，并帮他判断账号是否已经可用。当用户说「注册泡泡」「注册一个 powpow 账号」「泡泡怎么注册」「泡泡怎么付费」「注册收不到验证码」时触发。本技能不含任何脚本，不联网、不索取密码、验证码或支付凭证；注册与付款全部在用户自己的浏览器和官方收银台完成，助手只负责给链接、讲规则、陪排错。不含发帖与创建数字人，不含代码开发。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:powpow-register"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
