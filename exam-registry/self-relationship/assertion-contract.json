{
  "skillId": "self-relationship",
  "displayName": "self-relationship",
  "description": "帮助一个人更好地理解自己、接纳自己、调整自己，并在现实中做出更适合自己的选择。适用于用户谈论\"与自己相处\"、\"自我关系\"、\"自我接纳\"、\"自我理解\"、\"认识自己\"、\"自我成长\"、self-relationship、self-acceptance、self-understanding、self-growth 等话题时。不要试图把人变成\"更完美的人\"，不要把测试结果变成定义自己的标签。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:self-relationship"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
