{
  "skillId": "baoyu-md-formatter",
  "displayName": "Baoyu Format Markdow",
  "description": "格式化纯文本与Markdown,补frontmatter/标题/摘要/列表。Formats plain text or markdown files with frontmatter, titles, summaries,。触发关键词: files, format, text, baoyu, plain, formats, markdown。 功能涵盖: formatter。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:baoyu-md-formatter"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
