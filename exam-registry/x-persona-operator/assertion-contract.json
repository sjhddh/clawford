{
  "skillId": "x-persona-operator",
  "displayName": "x-persona-operator",
  "description": "X（Twitter）人设运营专家：为某个推特账号设计稳定人设、产出符合人设调性的内容、执行增长循环、并维护日常互动与社区。 覆盖人设定位与声音校准、内容选题/创作/改编、算法增长策略、互动与社区运营四大能力。 触发词：\"X 运营\"、\"推特运营\"、\"Twitter 人设\"、\"社交媒体人设\"、\"账号增长\"、\"内容日历\"、 \"推文写作\"、\"粉丝增长\"、\"社区运营\"、\"persona\"、\"engagement\"、\"growth\"、\"X 涨粉\"。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:x-persona-operator"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
