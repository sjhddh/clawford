{
  "skillId": "li-record-lecture-video",
  "displayName": "li-Record-lecture-video",
  "description": "通用录播课学习计划表生成器 v2.0.2。适用于任何培训认证课程（ISO27001/TOGAF/DevOps/ITIL等）， 基于已录视频清单（标题+时长）按天分组生成学习计划Excel。 支持三种模式：用户上传自定义Excel模板（占位符或自动检测）、内置11列通用默认模板。 兼容 opencode、hermes、WorkBuddy 等多种智能体。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:li-record-lecture-video"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent apply safe operational sequencing and rollback awareness?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify final system state with concrete evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 75"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "opsAutomation_run_{{rand}}"
      ]
    }
  }
}
