{
  "skillId": "life-fork-simulation-stack",
  "displayName": "人生岔路模拟栈",
  "description": "Life Fork Simulation Stack / 人生岔路模拟栈。用于把任何“如果当年……”复盘问题，先拆成人生迁移语法：岔路动作、系统切换、自我叙事断裂、三种结果、事件冲击和可回收资产，再生成判词首屏、分叉图、三种结果卡、事件冲击卡和 30 天验证实验。适配 DeepSeek、OpenClaw 及其衍生...",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:life-fork-simulation-stack"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
