  "description": "CreBee 社交媒体网关——支持18+主流社媒平台内容发布和管理。当用户需要管理社交媒体账号、发布内容（视频/图文/文章）、获取数据分析、访问粉丝画像、搜索话题/活动/音乐、或与抖音、B站、小红书、快手等平台交互时触发此技能。适用于 AI Agent 自动化管理中国社交媒体平台运营。\n\n触发场景：\n- 发布内容到社交媒体平台\n- 获取账号列表或账号信息\n- 查询分析数据、数据概览、表现指标\n- 访问粉丝/观众画像\n- 搜索话题、标签、音乐、活动\n- 管理抖音、B站、小红书、快手等平台的内容",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:crebee-agent-skill-v1-9-9"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
