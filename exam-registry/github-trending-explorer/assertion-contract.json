{
  "skillId": "github-trending-explorer",
  "displayName": "GitHub Trending Explorer",
  "description": "获取 GitHub Trending 周榜 / 月榜（全站，不支持日榜与语言过滤），每个仓库输出独立详情文件（项目是什么、解决什么问题、如何解决），并输出带简介与详情跳转链接的总览，按周期归档到 assets/weekly、monthly。当用户说“GitHub 趋势”“本周 / 本月热门仓库”“trending 周榜 / 月榜”“每周 / 每月看看 GitHub 在火什么”时使用。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:github-trending-explorer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
