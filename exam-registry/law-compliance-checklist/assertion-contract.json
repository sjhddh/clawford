{
  "skillId": "law-compliance-checklist",
  "displayName": "行业合规检查表",
  "description": "监管要求散落在多个文件里，小团队常常上线后才发现缺资质、缺公示、缺用户协议。 输入：行业（餐饮/教培/电商/医疗健康/美业/健身/家政/直播）、业务形态、渠道（线上/线下）、规模。输出：①资质清单（需要办什么、去哪儿办）②公示与告知要求 ③合同与用户协议要点 ④宣传合规红线（禁用词方向）⑤数据与隐私要求 ⑥开业前检查表（可打勾）。永久免费，无需付费、无需授权（MIT-0）。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:law-compliance-checklist"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
