{
  "skillId": "career-income-analyzer",
  "displayName": "职业收入分析",
  "description": "基于简历/工作经历进行全方位职业收入分析与变现路径规划。当用户提供简历、工作经历、或职业背景，并希望：1) 发掘隐藏技能变现价值 2) 寻找额外收入机会 3) 规划90天渐进式职业升级/副业落地路径 4) 识别AI驱动的第二收入来源时，使用此技能。触发词：简历分析、职业变现、收入机会、隐藏技能、第二收入、90天计划、职业规划、副业规划、技能变现。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:career-income-analyzer"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
