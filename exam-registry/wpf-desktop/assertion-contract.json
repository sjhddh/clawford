{
  "skillId": "wpf-desktop",
  "displayName": "wpf-desktop",
  "description": "Build, maintain or audit Windows WPF/XAML apps, including windows, DPI, tray, SDK/NuGet and packaging. Windows WPF 新建、维护与只读评估；新建或整体升级对齐 .NET 10，局部修复也检查已采用的建议依赖升级。SDK/TFM-only audits can use desktop-app-standard --dotnet.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:wpf-desktop"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
