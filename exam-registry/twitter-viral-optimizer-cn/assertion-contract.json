{
  "skillId": "twitter-viral-optimizer-cn",
  "displayName": "社媒爆款优化器",
  "description": "社交媒体内容传播优化工具，提供推文重写，发布时机规划，话题标签策略与内容分析功能。支持A/B测试方案设计，互动预测，账号诊断与发布日历制定。适用于产品发布推广，个人品牌建设，社媒矩阵运营等社交媒体营销场景。涵盖算法评分，评分卡制作，钩子优化，互动诱导，媒体建议等内容运营能力。内置多平台算法因子分析引擎，含标签策略组合，发布时间窗口推荐。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:twitter-viral-optimizer-cn"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
}
