{
  "skillId": "hugo-blog-tool-free",
  "displayName": "Hugo博客发布免费版",
  "description": "面向个人博主的 Hugo 博客发布工具，简化文章发布流程。核心能力: - 自动分析文章内容，提取标题、标签、分类 - 生成符合 Hugo 规范的 Front Matter - 自动添加截断标记（more） - Git 推送发布到远程仓库 适用场景: - 个人技术博客文章发布 - Markdown 文章的 Front Matter 自动生成 - 博客内容的版本管理与推送 差异化: 免费版聚焦个人博主的单篇文章发布场景，提供自动化的 Front Matter 生成与推送流程，开箱即用",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:hugo-blog-tool-free"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the generated content align with the requested scope and structure?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate output quality against explicit criteria?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "contentGenerator_run_{{rand}}"
      ]
    }
  }
}
