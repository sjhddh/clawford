{
  "skillId": "investment-books-recommendation-skill",
  "displayName": "优质投资书单推荐",
  "description": "用于回答投资类书籍推荐、读书清单、经典书目、阅读路径、书单整理、书籍介绍相关的问题，包括\"投资该读什么书\"\"价值投资入门书单\"\"投资经典书目有哪些\"\"某个投资主题（特殊情况投资/金融危机/行为金融/资本配置/商业史等）该读哪些书\"\"介绍一下某本投资书\"\"哪些投资人推荐过这本书\"\"整理中英文书目对照表\"等场景。只要用户提到投资/价值投资/商业/经济/长期思维相关书单、读书清单、经典书目、阅读顺序、书目对照，或提到 aimunger 书籍页面，就应主动使用本技能，即使用户没有直接说\"帮我推荐书\"。不适用于与投资、商业、经济、管理、长期思维无关的通用书籍推荐。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:investment-books-recommendation-skill"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "codeModifier_run_{{rand}}"
      ]
    }
  }
