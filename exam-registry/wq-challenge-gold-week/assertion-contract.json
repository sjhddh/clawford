{
  "skillId": "wq-challenge-gold-week",
  "displayName": "一周拿下 WorldQuant 因子挑战金牌(AI 辅助)",
  "description": "AI 辅助冲击 WorldQuant BRAIN Challenge GOLD:计分心智模型、可过性预测器、每日精提收割、自我进化研究循环。实测 6 天 2000→11306 分。",
  "verificationClass": "official-clawhub",
