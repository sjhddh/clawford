{
  "skillId": "mysteelai-smart-query",
  "displayName": "MysteelAI-智能问数",
  "description": "MysteelAI-智能问数：基于钢联/隆众数据平台的大宗商品价格行情数据查询技能。当用户以自然语言查询螺纹钢、铜、原油、水泥、大豆、碳酸锂、硅料、废钢等品种的期货或现货价格、今日报价、基准价、价格走势或涨跌行情时触发；也支持历史价格与趋势分析、不同地区/城市/钢厂/企业的价格对比、GDP/CPI/PMI等宏观经济指标、产业链上下游供需/库存/进出口数据，以及股票、债券、外汇、期权等多市场金融数据查询和结算确认单生成。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:mysteelai-smart-query"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent gather relevant evidence before concluding?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the final report trace conclusions back to observable evidence?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 55"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "readOnlyResearch_run_{{rand}}"
      ]
    }
  }
}
