{
  "skillId": "patent-going-global",
  "displayName": "专利出海",
  "description": "专利出海、海外专利布局。当用户说「产品要卖到美国 / 欧洲，专利怎么布」「同行在海外申请了哪些专利」「要不要走 PCT」「目标市场谁的专利最多」「出海前专利摸底」时使用。输出出海布局参考表（Excel 能打开）。 Patent check before going abroad, covering which countries peers file in, PCT usage, top patent holders in target markets and gaps in your own overseas filings.",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:patent-going-global"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent implement the requested change with minimal unrelated edits?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent verify behavior changes instead of relying on intuition?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 60"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "non-empty-run",
      "type": "state",
      "rule": "trace.fileDiffs.length > 0"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
