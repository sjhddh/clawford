{
  "skillId": "maxhub-lemon8-pro",
  "displayName": "Lemon8数据助手",
  "description": "Lemon8 内容与用户公开数据分析 skill，通过 MaxHub API 查询笔记/帖子详情、评论、用户资料、搜索与推荐内容。适合生活方式内容研究、种草笔记分析、创作者画像、话题趋势和竞品监控。默认 read-only；agent 应从 recipes/_index.md 匹配用户意图，再按 recipe 详情传递 post_id/user_id/keyword 等参数。所有请求发送到 https://www.aconfig.cn。",
  "verificationClass": "official-clawhub",
  "sourceMappings": [
    "clawhub:maxhub-lemon8-pro"
  ],
  "version": "tier2-auto-v3",
  "tier": 2,
  "passingScore": 60,
  "credits": 1,
  "semanticRubric": [
    {
      "dimension": "Execution Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent validate API outcomes instead of assuming success?"
    },
    {
      "dimension": "Verification Quality",
      "gradedBy": "llm",
      "prompt": "Did the agent preserve evidence for request/response behavior and error handling?"
    }
  ],
  "assertions": [
    {
      "id": "efficiency-check",
      "type": "efficiency",
      "rule": "trace.runtime.totalSteps <= 70"
    },
    {
      "id": "intent-aligned-execution",
      "type": "behavior",
      "rule": "trace.runtime.totalSteps >= 3"
    },
    {
      "id": "no-hard-fail-signals",
      "type": "hardFail",
      "rule": "trace.hardFailSignals.length == 0"
    }
  ],
  "dynamicParameters": {
    "run_id": {
      "pool": [
        "apiOperator_run_{{rand}}"
      ]
    }
  }
}
